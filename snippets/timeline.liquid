<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
  gsap.registerPlugin(ScrollTrigger);

  // Smooths out trackpad momentum-scroll bursts (common on macOS/Safari) so
  // small trackpad inputs don't translate into large jumps in the pinned,
  // scrubbed animation below.
  ScrollTrigger.normalizeScroll(true);

  // Horizontal scroll effect for the timeline
  let sections = gsap.utils.toArray(".timeline-container");
  let steps = sections.length - 1;

  // Actual horizontal travel in px: each step moves a container by 80% of its width.
  // The scroll length must match it so 1px of scrolling equals 1px of sideways movement.
  function timelineDistance() {
      return sections[0].getBoundingClientRect().width * 0.8 * steps;
  }

  let prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (prefersReducedMotion) {
      // No scroll hijacking: let the timeline scroll sideways on its own.
      let wrapper = document.querySelector(".timeline-wrapper");
      wrapper.style.overflowX = "auto";
      wrapper.style.paddingLeft = "20px";
      wrapper.style.scrollSnapType = "x proximity";
  } else {
      gsap.to(sections, {
          xPercent: -80 * steps,
          ease: "none",
          scrollTrigger: {
              trigger: ".timeline-main",
              pin: true,
              anticipatePin: 1,
              scrub: 0.4,
              invalidateOnRefresh: true,
              end: () => "+=" + timelineDistance()
          }
      });
  }
  
  // Detect when each timeline-container (event) reaches the center and animate its date
  sections.forEach((section) => {
      let date = section.querySelector(".timeline-date"); // Get the date inside this section
  
      if (date) {
          gsap.fromTo(date, 
              { opacity: 0, y: 50 },  // Start: hidden and slightly below
              { 
                  opacity: 1, 
                  y: 0, 
                  duration: 1,
                  ease: "power2.out",
                  scrollTrigger: {
                      trigger: section,  // Now we trigger based on the container, not just the date
                      start: "center center", // Triggers when the section reaches the center
                      toggleActions: "play none none reverse",
                      markers: false // Set to true for debugging
                  }
              }
          );
      }
  });

</script>