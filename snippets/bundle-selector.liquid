{%- liquid
  assign core_product = all_products.nodpod
  assign silk_product = all_products['nodpod-silk']
  assign body_product = all_products['nodpod-body']
-%}

{%- capture bundle_variant_images -%}
{
  "mask": {
    {%- for v in core_product.variants -%}
      "{{ v.id }}": [
        {%- assign imgs = v.metafields.custom.variant_images -%}
        {%- if imgs != blank -%}
          {%- assign files = imgs.value | default: imgs -%}
          {%- for f in files -%}
            {%- assign full  = f | image_url: width: 2048 -%}
            {%- assign thumb = f | image_url: width: 416  -%}
            {%- assign alt   = f.alt | default: v.title -%}
            {%- assign ratio = f.aspect_ratio | default: 1.0 -%}
            {"full": {{ full | json }}, "thumb": {{ thumb | json }}, "alt": {{ alt | json }}, "ratio": {{ ratio }}}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {%- if v.featured_image -%}
            {"full": {{ v.featured_image | img_url: '2048x' | json }}, "thumb": {{ v.featured_image | img_url: '416x' | json }}, "alt": {{ v.title | json }}, "ratio": {{ v.featured_image.aspect_ratio | default: 1.0 }}}
          {%- else -%}
            {"full": {{ core_product.featured_image | img_url: '2048x' | json }}, "thumb": {{ core_product.featured_image | img_url: '416x' | json }}, "alt": {{ core_product.title | json }}, "ratio": {{ core_product.featured_image.aspect_ratio | default: 1.0 }}}
          {%- endif -%}
        {%- endif -%}
      ]{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  },
  "silk": {
    {%- for v in silk_product.variants -%}
      "{{ v.id }}": [
        {%- assign imgs = v.metafields.custom.variant_images -%}
        {%- if imgs != blank -%}
          {%- assign files = imgs.value | default: imgs -%}
          {%- for f in files -%}
            {%- assign full  = f | image_url: width: 2048 -%}
            {%- assign thumb = f | image_url: width: 416  -%}
            {%- assign alt   = f.alt | default: v.title -%}
            {%- assign ratio = f.aspect_ratio | default: 1.0 -%}
            {"full": {{ full | json }}, "thumb": {{ thumb | json }}, "alt": {{ alt | json }}, "ratio": {{ ratio }}}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {%- if v.featured_image -%}
            {"full": {{ v.featured_image | img_url: '2048x' | json }}, "thumb": {{ v.featured_image | img_url: '416x' | json }}, "alt": {{ v.title | json }}, "ratio": {{ v.featured_image.aspect_ratio | default: 1.0 }}}
          {%- else -%}
            {"full": {{ silk_product.featured_image | img_url: '2048x' | json }}, "thumb": {{ silk_product.featured_image | img_url: '416x' | json }}, "alt": {{ silk_product.title | json }}, "ratio": {{ silk_product.featured_image.aspect_ratio | default: 1.0 }}}
          {%- endif -%}
        {%- endif -%}
      ]{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  },
  "body": {
    {%- for v in body_product.variants -%}
      "{{ v.id }}": [
        {%- assign imgs = v.metafields.custom.variant_images -%}
        {%- if imgs != blank -%}
          {%- assign files = imgs.value | default: imgs -%}
          {%- for f in files -%}
            {%- assign full  = f | image_url: width: 2048 -%}
            {%- assign thumb = f | image_url: width: 416  -%}
            {%- assign alt   = f.alt | default: v.title -%}
            {%- assign ratio = f.aspect_ratio | default: 1.0 -%}
            {"full": {{ full | json }}, "thumb": {{ thumb | json }}, "alt": {{ alt | json }}, "ratio": {{ ratio }}}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {%- if v.featured_image -%}
            {"full": {{ v.featured_image | img_url: '2048x' | json }}, "thumb": {{ v.featured_image | img_url: '416x' | json }}, "alt": {{ v.title | json }}, "ratio": {{ v.featured_image.aspect_ratio | default: 1.0 }}}
          {%- else -%}
            {"full": {{ body_product.featured_image | img_url: '2048x' | json }}, "thumb": {{ body_product.featured_image | img_url: '416x' | json }}, "alt": {{ body_product.title | json }}, "ratio": {{ body_product.featured_image.aspect_ratio | default: 1.0 }}}
          {%- endif -%}
        {%- endif -%}
      ]{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
}
{%- endcapture -%}

<script type="application/json" id="BundleVariantImages">
  {{ bundle_variant_images | strip_newlines }}
</script>

<div class="bundle-builder">
  <div class="bundle-title">
    <h1 class="bundle-main-title">The Better Sleep Bundle</h1>
  </div>

  <div class="bundle-price-wrap">
    <span class="bundle-price-final" data-bundle-price>$0.00</span>
    <span class="bundle-price-original" data-bundle-original></span>
    <span class="bundle-price-badge" data-bundle-badge></span>
  </div>

  <p class="bundle-headline">
    Includes a weighted eye mask and BODY, in your choice of premium fabric: cozy cotton or cooling mineral-infused
    silk.
  </p>

  <!-- ─────────  STEP 1  – mask choice  ───────── -->
  <div class="bundle-step">
    <h3>1. Choose your Nodpod</h3>

    <!-- ─────────  CORE MASK ROW  ───────── -->
    <div class="bundle-row">
      <img
        class="row-img"
        data-product-image="mask"
        src="{{ core_product.featured_image | img_url: '160x160' }}"
        width="60"
        height="60"
        alt="{{ core_product.title }}"
      >

      <div class="row-options">
        <p
          class="collection-label"
          data-selected-output="mask"
          data-base-label="Core Collection:"
        >
          Core Collection:
        </p>

        <div class="swatch-group" data-product="mask">
          {% for v in core_product.variants %}
            {% liquid
              assign hex = v.metafields.custom.variant_color | default: '#D1D1D1'
            %}
            <button
              type="button"
              class="color-swatch-pdp bundle-swatches pdp-color__label{% unless v.available %} is-disabled{% endunless %}"
              data-collection="Core Collection"
              data-tippy-content="{{ v.title }}"
              data-images="{{ v.metafields.custom.variant_images.value | json }}"
              data-variant-id="{{ v.id }}"
              data-price="{{ v.price }}"
              data-img="{{ v.featured_image | img_url: '300x300' }}"
              data-color="{{ hex }}"
              aria-label="{{ v.title }}"
              {% unless v.available %}
                aria-disabled="true" data-disabled="true"
              {% else %}
                aria-disabled="false"
              {% endunless %}
            >
              <span class="pdp-color__chip" style="background: {{ hex }};"></span>
            </button>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- ─────────  SILK MASK ROW  ───────── -->
    <div class="bundle-row">
      <img
        class="row-img"
        data-product-image="silk"
        src="{{ silk_product.featured_image | img_url: '160x160' }}"
        width="60"
        height="60"
        alt="{{ silk_product.title }}"
      >

      <div class="row-options">
        <div class="silk-label-wrapper">
          <p
            class="collection-label"
            data-selected-output="silk"
            data-base-label="Silk Collection (+ $25):"
          >
            Silk Collection (+ $25):
          </p>
          <a href="javascript:void(0)" class="why-silk-link" data-open-modal="why-silk">Why Silk?</a>

        </div>

        <div class="swatch-group" data-product="silk">
          {% for v in silk_product.variants %}
            {% liquid
              assign hex = v.metafields.custom.variant_color | default: '#D1D1D1'
            %}
            <button
              type="button"
              class="color-swatch-pdp bundle-swatches pdp-color__label{% unless v.available %} is-disabled{% endunless %}"
              data-collection="Core Collection"
              data-tippy-content="{{ v.title }}"
              data-images="{{ v.metafields.custom.variant_images.value | json }}"
              data-variant-id="{{ v.id }}"
              data-price="{{ v.price }}"
              data-img="{{ v.featured_image | img_url: '300x300' }}"
              data-color="{{ hex }}"
              aria-label="{{ v.title }}"
              {% unless v.available %}
                aria-disabled="true" data-disabled="true"
              {% else %}
                aria-disabled="false"
              {% endunless %}
            >
              <span class="pdp-color__chip" style="background: {{ hex }};"></span>
            </button>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- ─────────  STEP 2  – body blanket  ───────── -->
    <div class="bundle-step">
      <h3>2. Choose your Nodpod BODY</h3>

      <div class="bundle-row">
        <img
          class="row-img"
          data-product-image="body"
          src="{{ body_product.featured_image | img_url: '160x160' }}"
          width="60"
          height="60"
          alt="{{ body_product.title }}"
        >

        <div class="row-options">
          <p
            class="collection-label"
            data-selected-output="body"
            data-base-label="Core Collection:"
          >
            Core Collection:
          </p>

          <div class="swatch-group" data-product="body">
            {% for v in body_product.variants %}
              {% assign col = v.metafields.custom.collection_name.value | default: 'Collection' %}
              {% liquid
                assign hex = v.metafields.custom.variant_color | default: '#D1D1D1'
              %}
              <button
                type="button"
                class="color-swatch-pdp bundle-swatches pdp-color__label{% unless v.available %} is-disabled{% endunless %}"
                data-collection="Core Collection"
                data-tippy-content="{{ v.title }}"
                data-images="{{ v.metafields.custom.variant_images.value | json }}"
                data-variant-id="{{ v.id }}"
                data-price="{{ v.price }}"
                data-img="{{ v.featured_image | img_url: '300x300' }}"
                data-color="{{ hex }}"
                aria-label="{{ v.title }}"
                {% unless v.available %}
                  aria-disabled="true" data-disabled="true"
                {% else %}
                  aria-disabled="false"
                {% endunless %}
              >
                <span class="pdp-color__chip" style="background: {{ hex }};"></span>
              </button>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    <!-- ─────────  ADD-TO-CART  ───────── -->
    <button id="bundle-add-btn" class="bundle-add">ADD TO CART — <span data-bundle-price-inline>$0.00</span></button>

    <div id="why-silk-modal" class="modal" aria-hidden="true" role="dialog" aria-labelledby="why-silk-title">
      <div class="modal__backdrop" data-close-modal></div>
      <div class="modal__dialog" tabindex="-1">
        <button class="modal__close" type="button" aria-label="Close" data-close-modal>×</button>

        <div class="modal__content">
          <div class="modal__media">
            <!-- optional: swap to a theme asset if you want -->
            <img
              width="100%"
              height="auto"
              src="https://cdn.shopify.com/s/files/1/0253/2982/7939/files/Rectangle_126.png?v=1755100573"
              alt="Why Mineralized Silk"
              loading="lazy"
            >
          </div>
          <div class="modal__copy">
            <h3 id="why-silk-title">Why Mineralized Silk?</h3>
            <div class="modal-list">
              <div class="modal-list-row">
                <div class="modal-list-img">
                  <img
                    width="100%"
                    height="auto"
                    src="https://cdn.shopify.com/s/files/1/0253/2982/7939/files/silver_ion.png?v=1754700326"
                  >
                </div>
                <div class="modal-list-txt">
                  <p>Clinically Proven to Reduce Acne-Causing Bacteria by 99%</p>
                </div>
              </div>
              <div class="modal-list-row">
                <div class="modal-list-img">
                  <img
                    width="100%"
                    height="auto"
                    src="https://cdn.shopify.com/s/files/1/0253/2982/7939/files/supports_skin_health.png?v=1754700326"
                  >
                </div>
                <div class="modal-list-txt">
                  <p>Naturally Antimicrobial &amp; Gentle on Skin</p>
                </div>
              </div>
              <div class="modal-list-row">
                <div class="modal-list-img">
                  <img
                    width="100%"
                    height="auto"
                    src="https://cdn.shopify.com/s/files/1/0253/2982/7939/files/smoother_hair.png?v=1754700326"
                  >
                </div>
                <div class="modal-list-txt">
                  <p>Cooling, Breathable, and Frictionless</p>
                </div>
              </div>
            </div>
            <a class="modal__cta" href="/pages/why-silk">Learn More</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========== STYLES ========== -->
