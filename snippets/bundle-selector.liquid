        transparent 44%,
        var(--bundle-swatch-slash) 44%,
        var(--bundle-swatch-slash) 56%,
        transparent 56%
      );
    }

    /* ensure any legacy thin strike is suppressed */
    .bundle-builder .color-swatch-pdp.is-disabled:before { content: none !important; }
