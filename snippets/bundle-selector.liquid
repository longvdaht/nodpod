    /* === Bundle swatches use PDP classes === */
    .bundle-builder { --bundle-swatch-slash: #333; }

    .bundle-builder .pdp-color__label{
      width: 24px; height: 24px; border-radius: 999px;
      display: grid; place-items: center;
      padding: 0; border: 0; background: transparent;
      outline: 2px solid transparent; outline-offset: 3px;
      position: relative; cursor: pointer;
      transition: outline-color .18s ease, box-shadow .18s ease, opacity .18s ease;
    }
    .bundle-builder .pdp-color__label:focus-visible { outline-color: var(--np-outline, #636666); }

    .bundle-builder .pdp-color__chip{
      width: 100%; height: 100%; border-radius: inherit; position: relative;
    }

    /* selected ring (same as PDP) */
    .bundle-builder .pdp-color__label.selected .pdp-color__chip{
      box-shadow: 0 0 0 4px #fff, 0 0 0 5px var(--np-outline, currentColor);
    }

    /* disabled + diagonal slash (works even when selected) */
    .bundle-builder .pdp-color__label[aria-disabled="true"],
    .bundle-builder .pdp-color__label.is-disabled { opacity: .45; cursor: not-allowed; }

    .bundle-builder .pdp-color__label[aria-disabled="true"] .pdp-color__chip::after,
    .bundle-builder .pdp-color__label.is-disabled .pdp-color__chip::after{
      content: "";
      position: absolute; inset: 0; border-radius: inherit; z-index: 1; pointer-events: none;
      background-image: linear-gradient(
