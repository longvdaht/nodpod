<!-- ========== SCRIPT ========== -->
<script>
  (() => {
    const money = (c) => (c / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });

    /* ===== Variant image map (like PDP). Optional but preferred. ===== */
    const IMG_MAP = (() => {
      try {
        const el = document.getElementById('BundleVariantImages');
        return el ? JSON.parse(el.textContent) : {};
      } catch {
        return {};
      }
    })();

    /* Normalize images for a given group + variant id from the map */
    function imagesFromMap(group, variantId) {
      const g = String(group || '');
      const id = String(variantId || '');
      const arr = IMG_MAP?.[g]?.[id];
      return Array.isArray(arr) ? arr : [];
    }

    // reset the group's single label back to its base text (e.g., "Color:")
    const resetLabels = (group) => {
      document.querySelectorAll('.collection-label[data-selected-output="' + group + '"]').forEach((el) => {
        const base = el.getAttribute('data-base-label') || '';
        el.textContent = base; // plain text (no span) when cleared
      });
    };

    // write "Color: <span>Variant</span>" on the group's single label
    const updateSelectedLabel = (group, btn) => {
      resetLabels(group);

      const name = (btn.getAttribute('aria-label') || btn.dataset.tippyContent || '').trim();
      const target = document.querySelector('.collection-label[data-selected-output="' + group + '"]');

      if (target && name) {
        const base = (target.getAttribute('data-base-label') || 'Color:').trim();
        target.innerHTML = base + ' <span>' + name + '</span>';
      }
    };

    /* update bundle price */
    const refreshPrice = () => {
      let total = 0;
      ['mask', 'silk', 'body'].forEach((g) => {
        const sel = document.querySelector(`.swatch-group[data-product="${g}"] .color-swatch-pdp.selected`);
        if (sel) total += +sel.dataset.price;
      });

      const discounted = Math.round(total * 0.86); // 14% off
      const discountPct = 14;

      const priceFinal = document.querySelector('[data-bundle-price]');
      const priceOrig = document.querySelector('[data-bundle-original]');
      const priceBadge = document.querySelector('[data-bundle-badge]');
      const priceInline = document.querySelector('[data-bundle-price-inline]');

      if (priceFinal) priceFinal.textContent = money(discounted);
      if (priceOrig) priceOrig.textContent = money(total);
      if (priceBadge) priceBadge.textContent = `SAVE ${discountPct}%`;
      if (priceInline) priceInline.textContent = money(discounted);
    };

    /* ----------  GALLERY ADAPTER (Dawn)  ---------- */
    // Works if a Dawn gallery exists on the page. If not, it just no-ops.
    function getDawnNodes() {
      const wrapper =
        document.querySelector('.product__media-wrapper') ||
        document.querySelector('[id^="MediaGallery-"]') ||
        document.querySelector('media-gallery');
      const viewer =
        document.querySelector('[id^="Slider-Gallery-"]') || wrapper?.querySelector?.('[id^="Slider-Gallery-"]');
      const thumbs =
        document.querySelector('[id^="Slider-Thumbnails-"]') || wrapper?.querySelector?.('[id^="Slider-Thumbnails-"]');
      return { wrapper, viewer, thumbs };
    }

    function setActiveIndex(i = 0) {
      const { viewer, thumbs } = getDawnNodes();
      if (!viewer) return;

      const slides = Array.from(viewer.querySelectorAll('.slider__slide'));
      slides.forEach((s) => s.classList.remove('is-active'));
      const target = slides[i] || slides[0];
      if (target) target.classList.add('is-active');

      const cur = document.querySelector('.slider-counter--current');
      if (cur) cur.textContent = String((i || 0) + 1);

      if (thumbs) {
        thumbs.querySelectorAll('.thumbnail[aria-current]').forEach((t) => t.removeAttribute('aria-current'));
        const li = thumbs.querySelectorAll('.thumbnail-list__item')[i];
        const btn = li?.querySelector?.('.thumbnail');
        if (btn) btn.setAttribute('aria-current', 'true');
      }
    }

    function onGalleryReady(cb, timeout = 6000) {
      const ready = () => !!document.querySelector('[id^="Slider-Gallery-"]');
      if (ready()) return void cb();

      const obs = new MutationObserver(() => {
        if (ready()) {
          obs.disconnect();
          cb();
        }
      });
      obs.observe(document.body, { childList: true, subtree: true });

      setTimeout(() => {
        if (ready()) cb();
        obs.disconnect();
      }, timeout);
    }

    /* Replace the current gallery (if present) with new images. */
    function loadGallery(items = []) {
      const { viewer, thumbs } = getDawnNodes();

      // If there's no Dawn gallery on the page, just notify and exit
      if (!viewer) {
        document.dispatchEvent(new CustomEvent('bundle:gallery:changed', { detail: { count: items.length } }));
        return;
      }

      const makeId = (idx) => `bundle-${idx}`;

      const seenFirst = {}; // e.g. { mask: true, body: true }

      viewer.innerHTML = items
        .map((it, i) => {
          const full = (it && (it.full || it.url || it.src)) || it || '';
          const alt = (it && it.alt) || '';
          const ratio = Number(it && it.ratio) > 0 ? Number(it.ratio) : 1;
          const group = (it && it._group) || ''; // "mask" | "body" | ""
          const isFirst = group && !seenFirst[group]; // first image of that group?
          if (isFirst) seenFirst[group] = true;

          return `
          <li id="Slide-bundle-${i}"
              class="product__media-item grid__item slider__slide${i === 0 ? ' is-active' : ''}"
              data-media-id="bundle-${i}"
              data-media-position="${i + 1}"
              ${group ? `data-group="${group}"` : ''}
              data-first-of-group="${isFirst ? 'true' : 'false'}">
            <div class="product-media-container media" style="aspect-ratio:${ratio}">
              <img src="${full}" alt="${alt}" loading="${i === 0 ? 'eager' : 'lazy'}" class="global-media-settings"/>
            </div>
          </li>`;
        })
        .join('');

      // Thumbnails (if present)
      if (thumbs) {
        thumbs.innerHTML = items
          .map((it, i) => {
            const full = (it && (it.full || it.url || it.src)) || it || '';
            const thumb = (it && (it.thumb || it.url || it.src)) || full;
            const alt = (it && it.alt) || '';
            return `
          <li class="thumbnail-list__item slider__slide" data-target="${makeId(i)}" data-media-position="${i + 1}">
            <button type="button"
              class="thumbnail global-media-settings global-media-settings--no-shadow"
              ${i === 0 ? 'aria-current="true"' : ''}>
              <img src="${thumb}" alt="${alt}" loading="lazy">
            </button>
          </li>`;
          })
          .join('');
      }

      // Counters
      const total = document.querySelector('.slider-counter--total');
      if (total) total.textContent = String(items.length || 0);
      const cur = document.querySelector('.slider-counter--current');
      if (cur) cur.textContent = items.length ? '1' : '0';

      document.dispatchEvent(new CustomEvent('bundle:gallery:changed', { detail: { count: items.length } }));
    }

    // Delegated handler for all thumbnail clicks (initial Dawn + our rebuilt markup)
    document.addEventListener(
      'click',
      function (e) {
        const li = e.target.closest('.thumbnail-list__item');
        const list = li && li.closest('[id^="Slider-Thumbnails-"]');
        if (!li || !list) return;

        const items = Array.from(list.querySelectorAll('.thumbnail-list__item'));
        const idx = items.indexOf(li);
        if (idx < 0) return;

        e.preventDefault();
        e.stopPropagation();
        setActiveIndex(idx);
        document.dispatchEvent(new CustomEvent('bundle:gallery:changed'));
      },
      true
    );

    /* Prefer JSON map; fallback to button's data-images (JSON/CSV) */
    function getImages(btn) {
      const group = btn.closest('.swatch-group')?.dataset.product;
      const vid = btn.getAttribute('data-variant-id');

      // 1) Map lookup (best)
      const mapped = imagesFromMap(group, vid);
      if (mapped.length) return mapped;

      // 2) Fallback: parse data-images
      const raw = btn.dataset.images || '[]';
      try {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
          return parsed.map((it) =>
            typeof it === 'string'
              ? { full: it, thumb: it, alt: '', ratio: 1 }
              : {
                  full: it.full || it.url || it.src || '',
                  thumb: it.thumb || it.url || it.src || it.full || '',
                  alt: it.alt || '',
                  ratio: +it.ratio || 1,
                }
          );
        }
      } catch {}

      return raw
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean)
        .map((u) => ({ full: u, thumb: u, alt: '', ratio: 1 }));
    }

    function getSelectedBtn(group) {
      return document.querySelector(`.swatch-group[data-product="${group}"] .color-swatch-pdp.selected`);
    }
    function getSelectedMaskBtn() {
      // prefer Silk if chosen, otherwise Core
      return getSelectedBtn('silk') || getSelectedBtn('mask');
    }
    function getSelectedBodyBtn() {
      return getSelectedBtn('body');
    }
    function interleave(a = [], b = []) {
      const out = [];
      const max = Math.max(a.length, b.length);
      for (let i = 0; i < max; i++) {
        if (a[i]) out.push({ ...a[i], _group: 'mask' }); // mask (core or silk)
        if (b[i]) out.push({ ...b[i], _group: 'body' });
      }
      return out;
    }
    function refreshGalleryCombined() {
      const maskBtn = getSelectedMaskBtn();
      const bodyBtn = getSelectedBodyBtn();
      const maskImgs = maskBtn ? getImages(maskBtn) : [];
      const bodyImgs = bodyBtn ? getImages(bodyBtn) : [];

      const items =
        maskImgs.length && bodyImgs.length
          ? interleave(maskImgs, bodyImgs) // mask, body, mask, body...
          : maskImgs.length
          ? maskImgs.map((it) => ({ ...it, _group: 'mask' }))
          : bodyImgs.map((it) => ({ ...it, _group: 'body' }));

      loadGallery(items);
    }

    /* handle swatch clicks */
    document.querySelectorAll('.color-swatch-pdp').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        // block disabled
        if (
          btn.disabled ||
          btn.classList.contains('is-disabled') ||
          btn.getAttribute('aria-disabled') === 'true' ||
          btn.dataset.disabled === 'true'
        ) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }

        const group = btn.closest('.swatch-group').dataset.product;

        // ============  CLEAR OLD SELECTIONS  ============
        if (group === 'mask' || group === 'silk') {
          document
            .querySelectorAll(
              '.swatch-group[data-product="mask"] .color-swatch-pdp.selected, ' +
                '.swatch-group[data-product="silk"] .color-swatch-pdp.selected'
            )
            .forEach((b) => {
              b.classList.remove('selected');
              b.style.boxShadow = '';
            });
          const other = group === 'mask' ? 'silk' : 'mask';
          resetLabels(other);
        } else if (group === 'body') {
          document.querySelectorAll('.swatch-group[data-product="body"] .color-swatch-pdp.selected').forEach((b) => {
            b.classList.remove('selected');
            b.style.removeProperty('--np-outline');
            b.style.boxShadow = '';
          });
          resetLabels('body');
        }

        // ============  MARK SELECTED  ============
        btn.classList.add('selected');
        const selectedColor = btn.dataset.color || '#647D70';
        btn.style.setProperty('--np-outline', selectedColor);
        btn.style.boxShadow = '';

        // ============  UPDATE LABEL  ============
        updateSelectedLabel(group, btn);

        // ============  SWAP ROW IMAGE  ============
        const rowImg = document.querySelector('img[data-product-image="' + group + '"]');
        if (rowImg) rowImg.src = btn.dataset.img;

        // ============  GREY-OUT LOGIC  ============
        const maskImg = document.querySelector('img[data-product-image="mask"]');
        const silkImg = document.querySelector('img[data-product-image="silk"]');
        if (group === 'silk') {
          if (maskImg) maskImg.classList.add('grayed');
          if (silkImg) silkImg.classList.remove('grayed');
        } else if (group === 'mask') {
          if (silkImg) silkImg.classList.add('grayed');
          if (maskImg) maskImg.classList.remove('grayed');
        }

        // ============  GALLERY  ============
        refreshPrice();
        refreshGalleryCombined();
      });
    });

    /* add to cart handler — sequential adds with `_bundled` property + UpCart */
    document.getElementById('bundle-add-btn').addEventListener('click', (e) => {
      e.preventDefault();

      // Collect chosen items
      const items = [];
      const silkSel = document.querySelector('.swatch-group[data-product="silk"] .color-swatch-pdp.selected');
      const maskSel = document.querySelector('.swatch-group[data-product="mask"] .color-swatch-pdp.selected');
      const bodySel = document.querySelector('.swatch-group[data-product="body"] .color-swatch-pdp.selected');

      if (silkSel) items.push({ id: parseInt(silkSel.dataset.variantId, 10), quantity: 1 });
      else if (maskSel) items.push({ id: parseInt(maskSel.dataset.variantId, 10), quantity: 1 });

      if (bodySel) items.push({ id: parseInt(bodySel.dataset.variantId, 10), quantity: 1 });

      if (items.length !== 2) {
        alert('Select one mask (Core OR Silk) and one BODY.');
        return;
      }

      const bundleKey = 'bundle-' + Date.now();

      function addSequentially(queue, done) {
        if (!queue.length) return done();
        const item = queue[0];

        const payload = new URLSearchParams();
        payload.set('id', item.id);
        payload.set('quantity', item.quantity);
        payload.set('properties[_bundled]', 'true');
        payload.set('properties[_bundle_key]', bundleKey);

        fetch('/cart/add.js?upcart=1&opens_cart=maybe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
          body: payload.toString(),
        })
          .then((res) => {
            if (!res.ok) throw new Error('Add failed');
            return res.json();
          })
          .then(() => addSequentially(queue.slice(1), done))
          .catch((err) => done(err));
      }

      addSequentially(items, (err) => {
        if (err) {
          console.error('❌ Error adding bundle:', err);
          alert('There was an error adding your bundle to the cart. Please try again.');
          return;
        }
        if (typeof window.upcartRegisterAddToCart === 'function') window.upcartRegisterAddToCart();
        if (typeof window.upcartOpenCart === 'function') window.upcartOpenCart();
      });
    });

    // Preselect first available variants
    const preselect = (group) => {
      const firstBtn = document.querySelector(
        `.swatch-group[data-product="${group}"] .color-swatch-pdp:not([aria-disabled="true"])`
      );
      if (firstBtn) firstBtn.click();
    };

    preselect('mask');
    preselect('body');

    // Ensure initial gallery shows mask images (or silk if you preselect silk)
    onGalleryReady(refreshGalleryCombined);

    // Silk modal open/close (portal to <body> so it can't be clipped by product wrappers)
    (function () {
      let modal = document.getElementById('why-silk-modal');
      if (!modal) return;

      // ---- PORTAL: move the modal to <body> if it's not already there ----
      try {
        if (modal.parentElement !== document.body) {
          document.body.appendChild(modal);
        }
      } catch (e) {}

      const dialog = modal.querySelector('.modal__dialog');

      function openModal(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => dialog && dialog.focus());
      }

      function closeModal(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      // Bind directly to triggers so theme delegation can’t swallow it
      document.querySelectorAll('[data-open-modal="why-silk"]').forEach((btn) => {
        btn.addEventListener('click', openModal, true);
        btn.addEventListener(
          'keydown',
          (ev) => {
            if (ev.key === 'Enter' || ev.key === ' ') openModal(ev);
          },
          true
        );
      });

      // Backdrop / outside click / close button
      modal.addEventListener('click', (e) => {
        if (
          e.target.classList.contains('modal__backdrop') ||
          e.target.hasAttribute('data-close-modal') ||
          !e.target.closest('.modal__dialog')
        ) {
          closeModal(e);
        }
      });

      // ESC to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal(e);
      });

      // Optional: quick console helpers
      window.openWhySilkModal = openModal;
      window.closeWhySilkModal = closeModal;
    })();

    (function () {
      function removePressTags() {
        document.querySelectorAll('.press-tag-wrapper').forEach((el) => el.remove());
      }

      function insertPressTag() {
        var activeSlide = document.querySelector('[id^="Slider-Gallery-"] .slider__slide.is-active');
        if (!activeSlide) return;

        // Always clean up first
        removePressTags();

        // Only tag if this is the first slide of its group (mask/body)
        var shouldTag = activeSlide.getAttribute('data-first-of-group') === 'true';
        if (!shouldTag) return;

        var wrap = document.createElement('div');
        wrap.className = 'press-tag-wrapper';
        wrap.style.position = 'absolute';
        wrap.style.left = '0';
        wrap.style.bottom = '0';
        wrap.style.width = '100%';
        wrap.style.display = 'flex';
        wrap.style.justifyContent = 'center';
        wrap.style.pointerEvents = 'none';
        wrap.style.zIndex = '5';

        var img = document.createElement('img');
        img.className = 'press-tag';
        img.src = 'https://cdn.shopify.com/s/files/1/0253/2982/7939/files/press-tag.svg?v=1754703053';
        img.style.maxWidth = '380px';
        img.style.width = '100%';
        img.style.height = '60px';

        wrap.appendChild(img);
        activeSlide.insertBefore(wrap, activeSlide.firstChild);
      }

      insertPressTag();
      document.addEventListener('bundle:gallery:changed', insertPressTag);
      document.addEventListener(
        'click',
        function (e) {
          if (e.target.closest('.thumbnail')) setTimeout(insertPressTag, 0);
        },
        true
      );
    })();

    if (window.tippy) {
      tippy('.color-swatch-pdp', {
        content(reference) {
          return reference.getAttribute('data-tippy-content') || '';
        },
        allowHTML: true,
        interactive: false,
        placement: 'top',
        delay: [50, 0],
      });
    }
  })();
</script>
