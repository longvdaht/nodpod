{% comment %}
  Renders a product card

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
  - image_shape: {String} Image mask to apply to the product image card. Values are "arch", "blob", "chevronleft", "chevronright", "diamond", "parallelogram", and "round". (optional)
  - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_rating: {Boolean} Show the product rating. Default: false
  - extend_height: {Boolean} Card height extends to available container space. Default: true (optional)
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
  - skip_styles: {Boolean} Don't include component styles. Useful when rendering multiple product cards in a loop. Default: false (optional)
  - quick_add: {Boolean} Show the quick add button.
  - section_id: {String} The ID of the section that contains this card.
  - horizontal_class: {Boolean} Add a card--horizontal class if set to true. Default: false (optional)
  - horizontal_quick_add: {Boolean} Changes the quick add button styles when set to true. Default: false (optional)
  - placeholder_image: {String} The placeholder image to use when no product exists. Default: 'product-apparel-2' (optional)

  Usage:
  {% render 'card-product', show_vendor: section.settings.show_vendor %}
{% endcomment %}
{%- unless skip_styles -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}

  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'quick-order-list.css' | asset_url | stylesheet_tag }}
  {{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
{%- if card_product and card_product != empty -%}
  {%- liquid
    # Staff/preview detector (so hidden variants still show in editor/preview)
    assign staff_view = false
    if request.design_mode
      assign staff_view = true
    elsif content_for_header contains 'previewBarInjector'
      assign staff_view = true
    endif

    # Compute "first visible" + "first visible & available" + visibility check
    assign first_visible_variant = null
    assign first_available_variant = null
    assign any_visible_available = false
    assign has_visible_variants = false
    assign is_bundle = false
    if card_product.tags contains 'bundle'
      assign is_bundle = true
    endif

    for v in card_product.variants
      assign rr1 = v.metafields.release.ready.value
      assign rr2 = v.metafields.custom.release_ready.value

      # A variant is visible only if it is explicitly TRUE or if we're in staff view
      assign ready_true = false
      if rr1 == true or rr1 == 'true' or rr1 == 1 or rr1 == '1'
        assign ready_true = true
      elsif rr2 == true or rr2 == 'true' or rr2 == 1 or rr2 == '1'
        assign ready_true = true
      endif

      if staff_view or ready_true
        assign has_visible_variants = true
        if first_visible_variant == null
          assign first_visible_variant = v
        endif
        if v.available and first_available_variant == null
          assign first_available_variant = v
        endif
        if v.available
          assign any_visible_available = true
        endif
        if first_visible_variant and any_visible_available
          break
        endif
      endif
    endfor

    # Only render the card on live if there is at least one visible variant
    assign show_card = staff_view
    if show_card == false and has_visible_variants
      assign show_card = true
    endif

    # Choose the initial variant (prefer available over just visible)
    assign initial_variant = first_available_variant
    if initial_variant == null
      assign initial_variant = first_visible_variant
    endif

    # Badge override seed for initial selection
    assign product_badge = card_product.metafields.custom.listing_badge | strip
    assign initial_variant_badge = ''
    if initial_variant and initial_variant.metafields.custom.badge_text_override != blank
      assign initial_variant_badge = initial_variant.metafields.custom.badge_text_override | strip
    endif

    # Label for quick add (bundle copy)
    assign quick_label = 'products.product.choose_options' | t
    if is_bundle
      assign quick_label = 'Build Your Bundle'
    endif
  -%}

  {%- if show_card -%}
    {%- liquid
      assign ratio = 1
      if card_product.featured_media and media_aspect_ratio == 'portrait'
        assign ratio = 0.8
      elsif card_product.featured_media and media_aspect_ratio == 'adapt'
        assign ratio = card_product.featured_media.aspect_ratio
      endif
      if ratio == 0 or ratio == null
        assign ratio = 1
      endif
    -%}
    <div class="card-wrapper product-card-wrapper underline-links-hover">
      <div
        class="
          card card--{{ settings.card_style }}
          {% if card_product.featured_media %} card--media{% else %} card--text{% endif %}
          {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
          {% if image_shape and image_shape != 'default' %} card--shape{% endif %}
          {% if extend_height %} card--extend-height{% endif %}
          {% if card_product.featured_media == nil and settings.card_style == 'card' %} ratio{% endif %}
          {% if horizontal_class %} card--horizontal{% endif %}
        "
        style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
        data-np-initial-badge="{{ initial_variant_badge | default: product_badge | escape }}"
      >
        <div
          class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %}{% if card_product.featured_media or settings.card_style == 'standard' %} ratio{% endif %}"
          style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
        >
          {%- if card_product.featured_media -%}
            <a
              class="media-thumb"
              href="{{ card_product.url }}"
              aria-label="{{ card_product.title | escape }}"
            >
              <div class="card__media{% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ settings.card_color_scheme }} gradient{% endif %}">
                <div class="media media--transparent np-media">
                  <img
                    srcset="
                      {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                      {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                      {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                      {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                      {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                      {%- if card_product.featured_media.width >= 1066 -%}{{ card_product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                      {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
                    "
                    src="{{ card_product.featured_media | image_url: width: 533 }}"
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                    alt="{{ card_product.featured_media.alt | escape }}"
                    class="motion-reduce"
                    {% unless lazy_load == false %}
                      loading="lazy"
                    {% endunless %}
                    width="{{ card_product.featured_media.width }}"
                    height="{{ card_product.featured_media.height }}"
                  >

                  {%- if card_product.media[1] != null and show_secondary_image -%}
                    <img
                      srcset="
                        {%- if card_product.media[1].width >= 165 -%}{{ card_product.media[1] | image_url: width: 165 }} 165w,{%- endif -%}
                        {%- if card_product.media[1].width >= 360 -%}{{ card_product.media[1] | image_url: width: 360 }} 360w,{%- endif -%}
                        {%- if card_product.media[1].width >= 533 -%}{{ card_product.media[1] | image_url: width: 533 }} 533w,{%- endif -%}
                        {%- if card_product.media[1].width >= 720 -%}{{ card_product.media[1] | image_url: width: 720 }} 720w,{%- endif -%}
                        {%- if card_product.media[1].width >= 940 -%}{{ card_product.media[1] | image_url: width: 940 }} 940w,{%- endif -%}
                        {%- if card_product.media[1].width >= 1066 -%}{{ card_product.media[1] | image_url: width: 1066 }} 1066w,{%- endif -%}
                        {{ card_product.media[1] | image_url }} {{ card_product.media[1].width }}w
                      "
                      src="{{ card_product.media[1] | image_url: width: 533 }}"
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                      alt="{{ card_product.media[1].alt | escape }}"
                      class="motion-reduce"
                      loading="lazy"
                      width="{{ card_product.media[1].width }}"
                      height="{{ card_product.media[1].height }}"
                    >
                  {%- endif -%}
                </div>
              </div>
            </a>
          {%- endif -%}
          <div class="card__content">
            <div class="card__information">
              <h3
                class="card__heading"
                {% if card_product.featured_media == null and settings.card_style == 'standard' %}
                  id="title-{{ section_id }}-{{ card_product.id }}"
                {% endif %}
              >
                <a
                  href="{{ card_product.url }}"
                  id="StandardCardNoMediaLink-{{ section_id }}-{{ card_product.id }}"
                  class="full-unstyled-link"
                  aria-labelledby="StandardCardNoMediaLink-{{ section_id }}-{{ card_product.id }} NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}"
                >
                  {{ card_product.title | escape }}
                </a>
              </h3>
            </div>
            <div class="card__badge {{ settings.badge_position }}">
              {%- if any_visible_available == false -%}
                <span
                  id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}"
                  class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}"
                >
                  {{- 'products.product.sold_out' | t -}}
                </span>
              {%- elsif card_product.compare_at_price > card_product.price and any_visible_available -%}
                <span
                  id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}"
                  class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
                >
                  {{- 'products.product.on_sale' | t -}}
                </span>
              {%- endif -%}

              <span class="badge badge--bottom-left np-badge-override" hidden></span>
            </div>
          </div>
        </div>
        <div class="card__content">
          <div class="card__information">
          {% if settings.show_yotpo_rating_on_collection_card %}
            <div class="yotpo-widget-instance" data-yotpo-instance-id="621490" 
            data-yotpo-product-id="{{card_product.id}}" 
            data-yotpo-cart-product-id="{{card_product.id}}" 
            data-yotpo-section-id="{{template.name}}"></div>
          {%- elsif show_rating and card_product.metafields.reviews.rating.value != blank -%}
              {% liquid
                assign rating_decimal = 0
                assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1
                if decimal >= 0.3 and decimal <= 0.7
                  assign rating_decimal = 0.5
                elsif decimal > 0.7
                  assign rating_decimal = 1
                endif
              %}
              <div
                class="rating"
                role="img"
                aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}"
              >
                <span
                  aria-hidden="true"
                  class="rating-star"
                  style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                ></span>
              </div>
              <p class="rating-text caption">
                <span aria-hidden="true">
                  {{- card_product.metafields.reviews.rating.value }} /
                  {{ card_product.metafields.reviews.rating.value.scale_max -}}
                </span>
              </p>
              <p class="rating-count caption">
                <span aria-hidden="true">({{ card_product.metafields.reviews.rating_count }})</span>
                <span class="visually-hidden">
                  {{- card_product.metafields.reviews.rating_count }}
                  {{ 'accessibility.total_reviews' | t -}}
                </span>
              </p>
            {%- endif -%}
            <h3
              class="card__heading{% if card_product.featured_media or settings.card_style == 'standard' %} h5{% endif %}"
              {% if card_product.featured_media or settings.card_style == 'card' %}
                id="title-{{ section_id }}-{{ card_product.id }}"
              {% endif %}
            >
              <a
                href="{{ card_product.url }}"
                id="CardLink-{{ section_id }}-{{ card_product.id }}"
                class="full-unstyled-link"
                aria-labelledby="CardLink-{{ section_id }}-{{ card_product.id }} Badge-{{ section_id }}-{{ card_product.id }}"
              >
                {{ card_product.title | escape }}
              </a>
            </h3>
            <div class="card-information">
              {%- if show_vendor -%}
                <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
                <div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
              {%- endif -%}

              <span class="caption-large light">{{ block.settings.description | escape }}</span>

              {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
              {%- if card_product.metafields.descriptors.subtitle.value != blank and show_subtitle != false -%}
                <div class="card-subtitle">
                  <h3 class="h4">{{ card_product.metafields.descriptors.subtitle.value }}</h3>
                </div>
              {%- endif -%}
              {%- if card_product.quantity_price_breaks_configured? -%}
                {% if card_product.variants_count == 1 and quick_add == 'bulk' %}
                  {% liquid
                    assign quantity_rule = card_product.selected_or_first_available_variant.quantity_rule
                    assign has_qty_rules = false
                    if quantity_rule.increment > 1 or quantity_rule.min > 1 or quantity_rule.max != null
                      assign has_qty_rules = true
                    endif
                  %}
                  <quantity-popover>
                    <button class="card__information-volume-pricing-note card__information-volume-pricing-note--button card__information-volume-pricing-note--button-{{ settings.card_text_alignment }} quantity-popover__info-button--icon-only button button button--tertiary medium-hide small-hide">
                      <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
                    </button>
                    <button class="card__information-volume-pricing-note card__information-volume-pricing-note--button card__information-volume-pricing-note--button-{{ settings.card_text_alignment }} quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide">
                      <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
                    </button>
                {% else %}
                  <div class="card__information-volume-pricing-note">
                    <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
                  </div>
                {% endif %}
                {% if card_product.variants_count == 1 and quick_add == 'bulk' %}
                  <div
                    class="global-settings-popup quantity-popover__info"
                    tabindex="-1"
                    hidden
                    id="quantity-popover-info-{{ card_product.selected_or_first_available_variant.id }}"
                  >
                    {%- if has_qty_rules -%}
                      <div class="quantity__rules caption no-js-hidden">
                        {%- if quantity_rule.increment > 1 -%}
                          <span class="divider">
                            {{- 'products.product.quantity.multiples_of' | t: quantity: quantity_rule.increment -}}
                          </span>
                        {%- endif -%}
                        {%- if quantity_rule.min > 1 -%}
                          <span class="divider">
                            {{- 'products.product.quantity.min_of' | t: quantity: quantity_rule.min -}}
                          </span>
                        {%- endif -%}
                        {%- if quantity_rule.max != null -%}
                          <span class="divider">
                            {{- 'products.product.quantity.max_of' | t: quantity: quantity_rule.max -}}
                          </span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    <button
                      class="button-close button button--tertiary large-up-hide"
                      type="button"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {{- 'icon-close.svg' | inline_asset_content -}}
                    </button>
                    {%- if card_product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                      <volume-pricing class="parent-display">
                        <ul class="list-unstyled">
                          <li>
                            <span>{{ card_product.selected_or_first_available_variant.quantity_rule.min }}+</span>
                            {%- assign price = card_product.selected_or_first_available_variant.price
                              | money_with_currency
                            -%}
                            <span>{{ 'sections.quick_order_list.each' | t: money: price }}</span>
                          </li>
                          {%- for price_break in card_product.selected_or_first_available_variant.quantity_price_breaks -%}
                            <li>
                              <span>
                                {{- price_break.minimum_quantity -}}
                                <span aria-hidden="true">+</span></span
                              >
                              {%- assign price = price_break.price | money_with_currency -%}
                              <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </volume-pricing>
                    {%- endif -%}
                  </div>
                  </quantity-popover>
                {% endif %}
              {%- endif -%}
            </div>
            <div
              class="np-card-variants"
              data-product-id="{{ card_product.id }}"
              data-any-available="{{ any_visible_available }}"
              data-initial-variant-id="{{ initial_variant.id | default: '' }}"
              data-product-url="{{ card_product.url }}"
              data-is-bundle="{{ is_bundle }}"
            >
              {% assign size_option_index = -1 %}
              {% assign color_option_index = -1 %}
              {% for option_item in card_product.options_with_values %}
                {% assign option_name = option_item.name | downcase %}
                {% if option_name contains 'size' %}
                  {% assign size_option_index = forloop.index0 %}
                {% endif %}
                {% if option_name contains 'color' or option_name contains 'colour' %}
                  {% assign color_option_index = forloop.index0 %}
                {% endif %}
              {% endfor %}
              {% assign color_option_position = color_option_index | plus: 1 %}

              <div class="np-swatch-list" role="radiogroup" aria-label="{{ card_product.title | escape }}">
                {%- if is_bundle -%}
                  {%- if initial_variant -%}
                    {%- assign v = initial_variant -%}
                    {%- assign color_label = v.option1 | default: v.title -%}
                    {%- assign c1 = v.metafields.custom.variant_color.value
                      | default: v.metafields.custom.variant_color
                    -%}
                    {%- assign c2 = v.metafields.custom.variant_secondary_color.value
                      | default: v.metafields.custom.variant_secondary_color
                    -%}
                    {%- assign multicolor = v.metafields.custom.variant_multicolor -%}
                    {%- assign variant_swatch_image = v.metafields.custom.variant_swatch_image.value -%}
                    {%- comment -%} Resolve native Shopify swatch image for this variant color value. {%- endcomment -%}
                    {%- assign swatch_image_url = '' -%}
                    {%- assign color_option_value = '' -%}
                    {%- if color_option_index == 0 -%}
                      {%- assign color_option_value = v.option1 -%}
                    {%- elsif color_option_index == 1 -%}
                      {%- assign color_option_value = v.option2 -%}
                    {%- elsif color_option_index == 2 -%}
                      {%- assign color_option_value = v.option3 -%}
                    {%- endif -%}
                    {%- if color_option_index >= 0 and color_option_value != blank -%}
                      {%- for option_item in card_product.options_with_values -%}
                        {%- if option_item.position == color_option_position -%}
                          {%- for option_value in option_item.values -%}
                            {%- if option_value == color_option_value and option_value.swatch.image -%}
                              {%- assign swatch_image_url = option_value.swatch.image | image_url: width: 100 -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}

                    <button
                      type="button"
                      class="np-swatch {% if multicolor %}np-swatch--multi{% endif %}{% if v.available %}{% else %} is-disabled{% endif %} is-active"
                      role="radio"
                      aria-checked="true"
                      aria-label="{{ color_label | escape }}"
                      data-tippy-content="{{ color_label | escape }}"
                      data-variant-id="{{ v.id }}"
                      data-available="{{ v.available }}"
                      data-badge-override="{{ v.metafields.custom.badge_text_override | escape }}"
                      data-images="{% if v.metafields.custom.variant_images.value != blank %}{% for im in v.metafields.custom.variant_images.value %}{{ im | image_url: width: 1066 }}{% unless forloop.last %}|{% endunless %}{% endfor %}{% endif %}"
                      style="--np-outline: {% if c1 and c2 %}{{ c1 }}{% elsif multicolor %}rgba(165,154,185,1){% else %}{{ c1 | default: '#000' }}{% endif %};"
                    >
                      <span
                        class="np-swatch__chip"
                        style="{% if swatch_image_url != blank %}background-image: url('{{ swatch_image_url }}'); background-size: cover; background-position: center;{% elsif variant_swatch_image %}background-image: url('{{ variant_swatch_image | image_url: width: 100 }}'); background-size: cover; background-position: center;{% elsif c1 and c2 %}background: {{ c1 }}; background: linear-gradient(180deg, {{ c1 }} 0%, {{ c1 }} 54%, {{ c2 }} 54%);{% elsif multicolor %}background: rgb(165,154,185); background: linear-gradient(45deg, rgba(165,154,185,1) 0%, rgba(241,179,184,1) 20%, rgba(233,223,213,1) 40%, rgba(142,165,142,1) 60%, rgba(89,87,91,1) 80%, rgba(2,3,3,1) 100%);{% else %}background: {{ c1 | default: '#000' }};{% endif %}"
                      ></span>
                    </button>
                  {%- endif -%}
                {%- else -%}
                  {%- for v in card_product.variants -%}
                    {%- liquid
                      assign rr1 = v.metafields.release.ready.value
                      assign rr2 = v.metafields.custom.release_ready.value
                      assign ready_true = false
                      if rr1 == true or rr1 == 'true' or rr1 == 1 or rr1 == '1'
                        assign ready_true = true
                      elsif rr2 == true or rr2 == 'true' or rr2 == 1 or rr2 == '1'
                        assign ready_true = true
                      endif
                    -%}
                    {%- if staff_view or ready_true -%}
                      {%- assign is_initial = false -%}
                      {%- if initial_variant and initial_variant.id == v.id -%}
                        {% assign is_initial = true %}
                      {%- endif -%}
                      {%- assign color_label = v.option1 | default: v.title -%}
                      {%- assign c1 = v.metafields.custom.variant_color.value
                        | default: v.metafields.custom.variant_color
                      -%}
                      {%- assign c2 = v.metafields.custom.variant_secondary_color.value
                        | default: v.metafields.custom.variant_secondary_color
                      -%}
                      {%- assign multicolor = v.metafields.custom.variant_multicolor -%}
                      {%- assign variant_swatch_image = v.metafields.custom.variant_swatch_image.value -%}
                      {%- comment -%} Resolve native Shopify swatch image for this variant color value. {%- endcomment -%}
                      {%- assign swatch_image_url = '' -%}
                      {%- assign color_option_value = '' -%}
                      {%- if color_option_index == 0 -%}
                        {%- assign color_option_value = v.option1 -%}
                      {%- elsif color_option_index == 1 -%}
                        {%- assign color_option_value = v.option2 -%}
                      {%- elsif color_option_index == 2 -%}
                        {%- assign color_option_value = v.option3 -%}
                      {%- endif -%}
                      {%- if color_option_index >= 0 and color_option_value != blank -%}
                        {%- for option_item in card_product.options_with_values -%}
                          {%- if option_item.position == color_option_position -%}
                            {%- for option_value in option_item.values -%}
                              {%- if option_value == color_option_value and option_value.swatch.image -%}
                                {%- assign swatch_image_url = option_value.swatch.image | image_url: width: 100 -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}

                      {%- comment -%} derive size value/letter {%- endcomment -%}
                      {% assign size_value = '' %}
                      {% if size_option_index == 0 -%}
                        {%- assign size_value = v.option1 %}
                      {% elsif size_option_index == 1 -%}
                        {%- assign size_value = v.option2 %}
                      {% elsif size_option_index == 2 -%}
                        {%- assign size_value = v.option3 -%}
                      {%- endif %}
                      {% assign size_letter = size_value | slice: 0, 1 | upcase %}
                      {%- assign tippy_label = color_label -%}
                      {% if size_value != blank %}
                        {% assign tippy_label = color_label | append: ' ' | append: size_value %}
                      {% endif %}

                      <button
                        type="button"
                        class="np-swatch {% if multicolor %}np-swatch--multi{% endif %}{% if v.available %}{% else %} is-disabled{% endif %}{% if is_initial %} is-active{% endif %}{% if size_letter != blank %} np-swatch--labeled{% endif %}"
                        role="radio"
                        aria-checked="{% if is_initial %}true{% else %}false{% endif %}"
                        aria-label="{{ tippy_label | escape }}"
                        data-tippy-content="{{ tippy_label | escape }}"
                        data-variant-id="{{ v.id }}"
                        data-available="{{ v.available }}"
                        data-badge-override="{{ v.metafields.custom.badge_text_override | escape }}"
                        data-images="{% if v.metafields.custom.variant_images.value != blank %}{% for im in v.metafields.custom.variant_images.value %}{{ im | image_url: width: 1066 }}{% unless forloop.last %}|{% endunless %}{% endfor %}{% endif %}"
                        style="--np-outline: {% if c1 and c2 %}{{ c1 }}{% elsif multicolor %}rgba(165,154,185,1){% else %}{{ c1 | default: '#000' }}{% endif %};"
                      >
                        <span
                          class="np-swatch__chip"
                          style="{% if swatch_image_url != blank %}background-image: url('{{ swatch_image_url }}'); background-size: cover; background-position: center;{% elsif variant_swatch_image %}background-image: url('{{ variant_swatch_image | image_url: width: 100 }}'); background-size: cover; background-position: center;{% elsif c1 and c2 %}background: {{ c1 }}; background: linear-gradient(180deg, {{ c1 }} 0%, {{ c1 }} 54%, {{ c2 }} 54%);{% elsif multicolor %}background: rgb(165,154,185); background: linear-gradient(45deg, rgba(165,154,185,1) 0%, rgba(241,179,184,1) 20%, rgba(233,223,213,1) 40%, rgba(142,165,142,1) 60%, rgba(89,87,91,1) 80%, rgba(2,3,3,1) 100%);{% else %}background: {{ c1 | default: '#000' }};{% endif %}"
                        ></span>

                        {% if size_letter != blank %}
                          <span class="np-swatch__label" aria-hidden="true">{{ size_letter }}</span>
                        {% endif %}
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
          </div>
          {% assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id %}
          {% if quick_add == 'standard' %}
            <div class="quick-add no-js-hidden">
              {% if is_bundle %}
                <a href="{{ card_product.url }}" class="quick-add__submit button button--full-width button--secondary">
                  Build Your Bundle
                </a>
              {% else %}
                <form method="post" action="{{ routes.cart_add_url }}" class="form" novalidate>
                  <input
                    type="hidden"
                    name="id"
                    value="{{ initial_variant.id | default: card_product.selected_or_first_available_variant.id }}"
                    class="product-variant-id"
                    {% unless any_visible_available %}
                      disabled
                    {% endunless %}
                  >
                  <!--
                    ❌ DELETE everything you added here (the size_value/size_letter calc and the
                    extra <button class="np-swatch"> ... </button>)
                  -->
                  <button
                    type="submit"
                    class="quick-add__submit button button--full-width button--secondary"
                    {% unless any_visible_available %}
                      disabled
                    {% endunless %}
                  >
                    <span>
                      {% if any_visible_available -%}
                        {{- 'products.product.add_to_cart' | t -}}
                      {%- else -%}
                        {{- 'products.product.sold_out' | t -}}
                      {%- endif %}
                    </span>
                    <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                    {%- render 'loading-spinner' -%}
                  </button>
                </form>
              {% endif %}
            </div>
          {% elsif quick_add == 'bulk' %}
            {%- comment -%} Bulk quick add logic remains the same {%- endcomment -%}
            {% if card_product.variants_count == 1 %}
              <quick-add-bulk
                data-min="{{ card_product.selected_or_first_available_variant.quantity_rule.min }}"
                id="quick-add-bulk-{{ card_product.selected_or_first_available_variant.id }}-{{ section.id }}"
                class="quick-add-bulk"
                data-index="{{ card_product.selected_or_first_available_variant.id }}"
              >
                {% if card_product.selected_or_first_available_variant.available == false %}
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="quick-add__submit button button--full-width button--secondary"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    data-sold-out-message="true"
                    disabled
                  >
                    <span>{{ 'products.product.sold_out' | t }}</span>
                    <span class="sold-out-message hidden">
                      {{ 'products.product.sold_out' | t }}
                    </span>
                  </button>
                {% else %}
                  {% render 'quantity-input', variant: card_product.selected_or_first_available_variant, min: 0 %}
                {% endif %}
              </quick-add-bulk>
            {% else %}
              <div class="quick-add no-js-hidden">
                {%- liquid
                  assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id
                  assign qty_rules = false
                  if card_product.selected_or_first_available_variant.quantity_rule.min > 1 or card_product.selected_or_first_available_variant.quantity_rule.max != null or card_product.selected_or_first_available_variant.quantity_rule.increment > 1
                    assign qty_rules = true
                  endif
                -%}
                <modal-opener
                  id="QuickBulk-{{ card_product.id }}-{{ section_id }}"
                  data-modal="#QuickAddBulk-{{ card_product.id }}-{{ section.id }}"
                >
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="quick-add__submit button button--full-width button--secondary"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    data-product-url="{{ card_product.url }}"
                  >
                    {{ 'products.product.choose_options' | t }}
                    {%- render 'loading-spinner' -%}
                  </button>
                </modal-opener>
                <modal-dialog
                  id="QuickAddBulk-{{ card_product.id }}-{{ section_id }}"
                  class="quick-add-modal color-{{ section.settings.color_scheme }}"
                >
                  <div
                    role="dialog"
                    aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                    aria-modal="true"
                    class="quick-add-modal__content quick-add-modal__content--bulk global-settings-popup"
                    tabindex="-1"
                  >
                    <button
                      id="ModalClose-{{ card_product.id }}"
                      type="button"
                      class="quick-add-modal__toggle"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {{- 'icon-close.svg' | inline_asset_content -}}
                    </button>
                    <div
                      id="QuickAddInfo-{{ card_product.id }}"
                      class="quick-add-modal__content-info quick-add-modal__content-info--bulk"
                    >
                      <div class="quick-add__content-info__media">
                        <div class="quick-add__info">
                          {%- if card_product.featured_media -%}
                            <a
                              class="media-thumb"
                              href="{{ card_product.url }}"
                              aria-label="{{ card_product.title | escape }}"
                            >
                              <div class="card__media{% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ settings.card_color_scheme }} gradient{% endif %}">
                                <div class="media media--transparent media--hover-effect">
                                  <img
                                    srcset="
                                      {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                                      {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                                      {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                                      {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                                      {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                                      {%- if card_product.featured_media.width >= 1066 -%}{{ card_product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                                      {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
                                    "
                                    src="{{ card_product.featured_media | image_url: width: 533 }}"
                                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                                    alt="{{ card_product.featured_media.alt | escape }}"
                                    class="motion-reduce"
                                    {% unless lazy_load == false %}
                                      loading="lazy"
                                    {% endunless %}
                                    width="{{ card_product.featured_media.width }}"
                                    height="{{ card_product.featured_media.height }}"
                                  >

                                  {%- if card_product.media[1] != null and show_secondary_image -%}
                                    <img
                                      srcset="
                                        {%- if card_product.media[1].width >= 165 -%}{{ card_product.media[1] | image_url: width: 165 }} 165w,{%- endif -%}
                                        {%- if card_product.media[1].width >= 360 -%}{{ card_product.media[1] | image_url: width: 360 }} 360w,{%- endif -%}
                                        {%- if card_product.media[1].width >= 533 -%}{{ card_product.media[1] | image_url: width: 533 }} 533w,{%- endif -%}
                                        {%- if card_product.media[1].width >= 720 -%}{{ card_product.media[1] | image_url: width: 720 }} 720w,{%- endif -%}
                                        {%- if card_product.media[1].width >= 940 -%}{{ card_product.media[1] | image_url: width: 940 }} 940w,{%- endif -%}
                                        {%- if card_product.media[1].width >= 1066 -%}{{ card_product.media[1] | image_url: width: 1066 }} 1066w,{%- endif -%}
                                        {{ card_product.media[1] | image_url }} {{ card_product.media[1].width }}w
                                      "
                                      src="{{ card_product.media[1] | image_url: width: 533 }}"
                                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                                      alt="{{ card_product.media[1].alt | escape }}"
                                      class="motion-reduce"
                                      loading="lazy"
                                      width="{{ card_product.media[1].width }}"
                                      height="{{ card_product.media[1].height }}"
                                    >
                                  {%- endif -%}
                                </div>
                              </div>
                            </a>
                          {%- endif -%}

                          <a
                            {% if card_product == blank %}
                              role="link" aria-disabled="true"
                            {% else %}
                              href="{{ card_product.url }}"
                            {% endif %}
                            class="link product__view-details animate-arrow small-hide medium-hide"
                          >
                            {{ 'products.product.view_full_details' | t -}}
                            {{- 'icon-arrow.svg' | inline_asset_content -}}
                          </a>
                        </div>
                        <div class="quick-add-modal__content-info--bulk-details large-up-hide">
                          <a href="{{ card_product.url }}" class="full-unstyled-link">
                            <h3>{{ card_product.title | escape }}</h3>
                          </a>
                          {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
                          {%- if card_product.quantity_price_breaks_configured? -%}
                            <div class="card__information-volume-pricing-note">
                              <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
                            </div>
                          {%- endif -%}
                        </div>
                      </div>
                      <div>
                        <div class="quick-add-modal__content-info--bulk-details small-hide medium-hide">
                          <a href="{{ card_product.url }}" class="full-unstyled-link">
                            <h3 class="h2">
                              {{ card_product.title | escape }}
                            </h3>
                          </a>
                          {% render 'price', product: card_product, price_class: '', show_compare_at_price: true %}
                          {%- if card_product.quantity_price_breaks_configured? -%}
                            <div class="card__information-volume-pricing-note">
                              <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
                            </div>
                          {%- endif -%}
                        </div>
                        <bulk-modal
                          id="QuickBulkModal-{{ card_product.id }}-{{ section_id }}"
                          data-url="{{ card_product.url }}"
                          data-section-id="{{ section_id }}"
                          data-product-id="{{ card_product.id }}"
                        >
                        </bulk-modal>
                      </div>
                    </div>
                  </div>
                </modal-dialog>
              </div>
            {% endif %}
          {% endif %}
          <div class="card__badge {{ settings.badge_position }}">
            {%- if any_visible_available == false -%}
              <span
                id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}"
                class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}"
              >
                {{- 'products.product.sold_out' | t -}}
              </span>
            {%- elsif card_product.compare_at_price > card_product.price and any_visible_available -%}
              <span
                id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}"
                class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
              >
                {{- 'products.product.on_sale' | t -}}
              </span>
            {%- endif -%}
            <!-- Always render the override badge -->
            <span class="badge badge--bottom-left np-badge-override" hidden></span>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
{%- else -%}
  {%- comment -%} Fallback placeholder card when no product {%- endcomment -%}
  {%- liquid
    assign ratio = 1
    assign placeholder = true
    if media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    endif
  -%}
  <div class="card-wrapper product-card-wrapper underline-links-hover">
    <div
      class="
        card card--{{ settings.card_style }}
        {% if extend_height %} card--extend-height{% endif %}
        {% if image_shape and image_shape != 'default' %} card--shape{% endif %}
        {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
      "
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      <div
        class="card__inner{% if settings.card_style == 'standard' %} color-{{ settings.card_color_scheme }} gradient{% endif %} ratio"
      >
        <div
          class="card__media {% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ settings.card_color_scheme }} gradient{% endif %}"
        >
          <div
            class="media media--transparent"
          >
            {%- if placeholder_image -%}
              {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
            {%- else -%}
              {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        </div>
      </div>
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading card__heading--placeholder{% if settings.card_style == 'standard' %} h5{% endif %}">
            <a role="link" aria-disabled="true" class="full-unstyled-link">
              {{ 'onboarding.product_title' | t }}
            </a>
          </h3>
          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ 'products.product.vendor' | t }}</div>
            {%- endif -%}
            {% render 'price', placeholder: placeholder, show_compare_at_price: true %}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} Keep all existing CSS and JavaScript from your original file {%- endcomment -%}
{%- unless skip_styles -%}
<style>
   /* Kill Dawn's full-card overlay from title links */
   .product-card-wrapper .full-unstyled-link::after,
   .card .full-unstyled-link::after { content: none !important; pointer-events: none !important; }

   /* Aspect lock + media box */
   .product-card-wrapper .card__inner.ratio { position: relative; overflow: hidden; padding: 0 !important;
    border: 1px solid #EBEAE6;
    border-radius: 10px;
   }
   .product-card-wrapper .card__inner.ratio::before { content: ""; display: block; padding-bottom: var(--ratio-percent); }
   .product-card-wrapper .card__media { position: absolute; inset: 0; }
   .product-card-wrapper .card__media .media { position: absolute; inset: 0; width: 100%; height: 100%; }
   .card-wrapper {
     padding: 10px;
   }
   .card.card--card.card--media {
    padding: 10px;
  }

   /* Image-only anchor wraps the two imgs */
   .product-card-wrapper .media-thumb { position: absolute; inset: 0; display: block; z-index: 20; background: transparent; }
   .product-card-wrapper .media-thumb > img {
     position: absolute; inset: 0; width: 100%; height: 100%;
     object-fit: cover; display: block; transition: opacity .25s ease;
   }
  .media-thumb img:nth-of-type(1) {
     opacity: 1 !important;
   }
   .media-thumb img:nth-of-type(2) {
     opacity: 0 !important;
   }
   .media-thumb:hover img:nth-of-type(1) {
   opacity: 0 !important;
   }
   .media-thumb:hover img:nth-of-type(2) {
   opacity: 1 !important;
   }

   /* Badges (on top, don't block clicks) */
   .product-card-wrapper .card__badge { position: absolute; z-index: 30; pointer-events: none; margin: 0; }
   .product-card-wrapper .badge--bottom-left  { left: .75rem; bottom: .75rem; }
   .product-card-wrapper .badge--bottom-right { right: .75rem; bottom: .75rem; }
   .product-card-wrapper .badge--top-left     { left: .75rem; top:    .75rem; }
   .product-card-wrapper .badge--top-right    { right: .75rem; top:    .75rem; }
   .product-card-wrapper .card .card__badge ~ .card__badge { display: none; }

   /* Swatches */
   .np-card-variants { margin: .6rem 0 .2rem; position: relative; z-index: 2; }
   .np-swatch-list { display: flex; flex-wrap: wrap; column-gap: .5rem; row-gap: 0.85rem; }
   .np-swatch {
      --ring: 2px;
      appearance: none;
      border: 0;
      background: transparent;
      padding: 0;
      cursor: pointer;
      position: relative;
      border-radius: 999px;
      width: 20px !important;
      height: 20px !important;
      display: inline-grid;
      place-items: center;
      outline: var(--ring) solid transparent;
      outline-offset: 2px;
      transition: outline-color .2s ease;
      z-index: 3;
      outline: var(--ring) solid transparent;
      outline-offset: 2px;
      margin-right: 4px;
    }
   .np-swatch.is-active { outline-color: var(--np-outline, currentColor); }
   .np-swatch.is-disabled { opacity: .45; cursor: not-allowed; }
   .np-swatch__chip { width: 100%; height: 100%; border-radius: 999px; border: 0 !important; background: #ccc; }
   .np-swatch--multi .np-swatch__chip { background: repeating-linear-gradient(45deg,#222 0 8px,#fff 8px 16px,#666 16px 24px); }
   .np-swatch.is-disabled .np-swatch__chip::after {
      content: '';
      width: 100%;
      height: 100%;
      position: absolute;
      top: 6px;
      left: 6px;
      border-left: 2px solid #fff;
      transform: rotate(45deg);
    }
   .np-badge-override[hidden] { display: none !important; }

   /* ------- Tippy minimal theme (bottom arrow) ------- */
   .tippy-box[data-theme~="np"]{
     background: rgba(17,17,17,.92);
     color:#fff;
     border-radius: 8px;
     font-size: 12px;
     line-height: 1;
     padding: 6px 8px;
     box-shadow: 0 6px 20px rgba(0,0,0,.18);
   }
  .tippy-box[data-theme~="np"] > .tippy-arrow{ width:10px; height:10px; }
  .tippy-box[data-theme~="np"] > .tippy-arrow::before{
    content:"";
    position:absolute;
    width:10px; height:10px;
    transform: rotate(45deg);
    background: inherit;
  }

  /* Tooltip is ABOVE the swatch → arrow lives on tooltip's BOTTOM */
  .tippy-box[data-theme~="np"][data-placement^="top"] > .tippy-arrow { bottom:-5px; }
  .tippy-box[data-theme~="np"][data-placement^="top"] > .tippy-arrow::before {
    box-shadow: 1px 1px 1px rgba(0,0,0,.05);
  }
  .quick-add__submit.button.button--full-width.button--secondary {
    border: 1px solid currentColor !important;
    font-family: var(--font-heading-family);
    text-transform: capitalize;
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.5px;
    font-size: 2rem;
    text-decoration: none !important;
  }
  .quick-add__submit.button.button--full-width.button--secondary::after {
    display: none !important;
  }
  .card-wrapper .rating-star {
    --letter-spacing: 0.1 !important;
    --font-size: 1.6 !important;
  }
  .card__heading a {
    font-size: 2.25rem;
    font-weight: 300;
    letter-spacing: 0;
    text-decoration: none !important;
  }
  .card .price {
    font-family: var(--font-heading-family);
    font-weight: 300;
    margin-bottom: 12px;
    font-size: 2rem;
    margin-top: 0 !important;
  }
  .card--card .quick-add {
    margin: 0 !important;
  }
  .np-badge-override {
    background: #75787B;
    color: #fff;
    padding: 10px 15px;
  }
  .card-subtitle h3 {
    font-style: italic !important;
    font-weight: 300;
    letter-spacing: 0;
    font-size: 1.75rem !important;
    margin-top: 0;
  }
  /* Letter overlay inside swatch */
  .np-swatch__label{
    position:absolute;
    inset:0;
    display:grid;
    place-items:center;
    font-size:10px;
    font-weight:700;
    line-height:1;
    letter-spacing:.02em;
    text-transform:uppercase;
    color:#000;
    pointer-events:none;
    user-select:none;
  }
  .np-swatch.is-disabled .np-swatch__label{ opacity:.75; }
</style>

<script>
  (function () {
    function setBadgeOverride(cardEl, text) {
      cardEl.querySelectorAll('.card__badge').forEach(function (wrap) {
        const def = wrap.querySelector('.badge:not(.np-badge-override)');
        const ov = wrap.querySelector('.np-badge-override');
        if (!ov) return;
        if (text && text.trim()) {
          ov.textContent = text.trim();
          ov.hidden = false;
          if (def) def.style.display = 'none';
        } else {
          ov.hidden = true;
          if (def) def.style.display = '';
        }
      });
    }

    // UPDATED: targets the new anchor-wrapped images first
    function updateImages(cardEl, urls) {
      let imgs = cardEl.querySelectorAll('.media-thumb > img');
      if (!imgs.length) imgs = cardEl.querySelectorAll('.card__media .media > img'); // fallback if needed
      if (!imgs.length) return;

      imgs.forEach(function (img) {
        if (!img.dataset.defaultSrc) {
          img.dataset.defaultSrc = img.getAttribute('src') || '';
          img.dataset.defaultSrcset = img.getAttribute('srcset') || '';
        }
      });

      if (urls && urls.length) {
        if (imgs[0]) {
          imgs[0].src = urls[0];
          imgs[0].srcset = urls[0];
        }
        if (imgs[1]) {
          const u = urls[1] || urls[0];
          imgs[1].src = u;
          imgs[1].srcset = u;
        }
      } else {
        imgs.forEach(function (img) {
          if (img.dataset.defaultSrc) img.src = img.dataset.defaultSrc;
          if (img.dataset.defaultSrcset) img.srcset = img.dataset.defaultSrcset;
        });
      }
    }

    function setActiveSwatch(btn) {
      const list = btn.closest('.np-swatch-list');
      if (!list) return;
      list.querySelectorAll('.np-swatch').forEach(function (b) {
        b.classList.remove('is-active');
        b.setAttribute('aria-checked', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-checked', 'true');
    }

    function syncQuickAdd(wrapper, variantId) {
      const hidden = wrapper.querySelector('input.product-variant-id');
      if (hidden) hidden.value = variantId;
    }

    /* ---------- Tippy boot ---------- */
    function ensureTippy(cb) {
      if (window.tippy) return cb && cb();
      var s = document.createElement('script');
      s.src = 'https://unpkg.com/tippy.js@6/dist/tippy-bundle.umd.min.js';
      s.async = true;
      s.onload = function () {
        cb && cb();
      };
      document.head.appendChild(s);
    }

    function initTippyFor(container) {
      if (!window.tippy || !container) return;
      container.querySelectorAll('.np-swatch[data-tippy-content]').forEach(function (el) {
        if (el._tippy) return;
        window.tippy(el, {
          content: el.getAttribute('data-tippy-content') || '',
          theme: 'np',
          placement: 'top',
          arrow: true,
          duration: [120, 80],
          offset: [0, 10],
          interactive: false,
          allowHTML: false,
          trigger: 'mouseenter focus',
          appendTo: function () {
            return document.body;
          },
          touch: ['hold', 300],
        });
      });
    }

    function initCard(wrapper) {
      if (!wrapper || wrapper.dataset.npInit === '1') return;
      wrapper.dataset.npInit = '1';

      const card = wrapper.querySelector('.card');
      const picker = wrapper.querySelector('.np-card-variants');
      if (!card || !picker) return;

      // Initial state
      const active =
        picker.querySelector('.np-swatch.is-active') || picker.querySelector('.np-swatch:not(.is-disabled)');
      if (active) {
        const imgs = (active.dataset.images || '').split('|').filter(Boolean);
        updateImages(wrapper, imgs.length ? imgs : null);
        const vBadge = (active.dataset.badgeOverride || '').trim();
        const pBadge = (card.dataset.npInitialBadge || '').trim();
        setBadgeOverride(card, vBadge || pBadge);
        const vid = active.dataset.variantId;
        if (vid) syncQuickAdd(wrapper, vid);
      }

      // Swatch interactions
      picker.addEventListener(
        'click',
        function (e) {
          const btn = e.target.closest('.np-swatch');
          if (!btn || btn.classList.contains('is-disabled')) return;
          e.preventDefault();

          setActiveSwatch(btn);
          const urls = (btn.dataset.images || '').split('|').filter(Boolean);
          updateImages(wrapper, urls.length ? urls : null);

          const vBadge = (btn.dataset.badgeOverride || '').trim();
          const pBadge = (card.dataset.npInitialBadge || '').trim();
          setBadgeOverride(card, vBadge || pBadge);

          const vid = btn.dataset.variantId;
          if (vid) syncQuickAdd(wrapper, vid);
        },
        { capture: true }
      );

      // Keyboard support
      picker.addEventListener(
        'keydown',
        function (e) {
          const btn = e.target.closest('.np-swatch');
          if (!btn || btn.classList.contains('is-disabled')) return;
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            btn.click();
          }
        },
        { capture: true }
      );

      // Init tippy for this card (after swatches exist)
      ensureTippy(function () {
        initTippyFor(wrapper);
      });
    }

    // Init existing cards
    document.querySelectorAll('.product-card-wrapper').forEach(initCard);

    // Init cards that appear later (Collection filtering / AJAX)
    new MutationObserver(function (muts) {
      muts.forEach(function (m) {
        m.addedNodes.forEach(function (n) {
          if (n.nodeType !== 1) return;
          if (n.matches && n.matches('.product-card-wrapper')) {
            initCard(n);
          }
          n.querySelectorAll && n.querySelectorAll('.product-card-wrapper').forEach(initCard);
          // If swatches are injected into existing cards, (re)bind tippy for them
          if (n.querySelectorAll) {
            ensureTippy(function () {
              document.querySelectorAll('.product-card-wrapper').forEach(initTippyFor);
            });
          }
        });
      });
    }).observe(document.documentElement, { childList: true, subtree: true });

    // If tippy loads after DOM ready, bind once globally
    ensureTippy(function () {
      document.querySelectorAll('.product-card-wrapper').forEach(initTippyFor);
    });
  })();
</script>
{%- endunless -%}
