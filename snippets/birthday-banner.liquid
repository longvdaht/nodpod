<script>
document.addEventListener("DOMContentLoaded", function () {
  // Dawn theme selectors - adjust these based on your actual Dawn structure
  const productCards = document.querySelectorAll('.card-wrapper, .product-card-wrapper, .grid__item');
  
  productCards.forEach(card => {
    // Look for variant selectors within each product card
    const variantSwatches = card.querySelectorAll(
      '.product-form__buttons input[type="radio"], ' +
      '.variant-picker input[type="radio"], ' +
      '.product-option input[type="radio"], ' +
      '[data-variant-id]'
    );
    
    let birthdayBlueVariant = null;
    
    // Find the birthday blue variant
    variantSwatches.forEach(swatch => {
      const label = swatch.nextElementSibling || swatch.closest('label') || swatch.parentElement;
      const variantName = (label?.textContent || swatch.value || '').toLowerCase();
      
      // Look for birthday blue in various formats
      if (variantName.includes('birthday blue') || 
          variantName.includes('birthdayblue') || 
          variantName.includes('birthday-blue') ||
          swatch.getAttribute('data-variant-name')?.toLowerCase().includes('birthday blue')) {
        birthdayBlueVariant = swatch;
      }
    });
    
    // If birthday blue variant found, select it
    if (birthdayBlueVariant) {
      // Select the variant
      birthdayBlueVariant.checked = true;
      birthdayBlueVariant.click();
      
      // Update hidden form input if it exists
      const hiddenInput = card.querySelector('input[name="id"]');
      const variantId = birthdayBlueVariant.value || birthdayBlueVariant.getAttribute('data-variant-id');
      
      if (hiddenInput && variantId) {
        hiddenInput.value = variantId;
      }
      
      // Update product image if there's a data attribute
      const productImage = card.querySelector('.card__media img, .product-card__image img, .media img');
      const variantImageSrc = birthdayBlueVariant.getAttribute('data-variant-image') || 
                             birthdayBlueVariant.getAttribute('data-src');
      
      if (productImage && variantImageSrc) {
        productImage.src = variantImageSrc;
        productImage.srcset = ''; // Clear srcset to force new image
      }
      
      // Trigger change event for any listeners
      birthdayBlueVariant.dispatchEvent(new Event('change', { bubbles: true }));
      
      // Remove active class from other swatches and add to selected
      card.querySelectorAll('.variant-picker__option, .color-swatch, .product-option').forEach(option => {
        option.classList.remove('active', 'selected');
      });
      
      const selectedOption = birthdayBlueVariant.closest('.variant-picker__option, .color-swatch, .product-option');
      if (selectedOption) {
        selectedOption.classList.add('active', 'selected');
      }
    }
  });
});
</script>