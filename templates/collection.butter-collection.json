    "custom_liquid_jL78yC": {
      "type": "custom-liquid",
      "custom_css": [
        ".footer-butter {height: 300px; width: 100%; background: url(\"https://cdn.shopify.com/s/files/1/0253/2982/7939/files/AdobeStock_180087729_1.png?v=1756316456\"); background-size: auto 400px; background-repeat: no-repeat; background-position: left bottom; margin-top: -130px;}"
      ],
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"footer-butter\">\n</div>\n<script>\n(function () {\n  // Prefer these variants when present & available\n  const NP_PREFERRED_VARIANTS = new Set([\n    '47367482146986', // Sleep Mask — Butter Yellow\n    '47368430452906'  // BODY — Butter Yellow\n  ]);\n\n  function setBadgeOverride(cardEl, text) {\n    cardEl.querySelectorAll('.card__badge').forEach(function (wrap) {\n      const def = wrap.querySelector('.badge:not(.np-badge-override)');\n      const ov  = wrap.querySelector('.np-badge-override');\n      if (!ov) return;\n      if (text && text.trim()) {\n        ov.textContent = text.trim();\n        ov.hidden = false;\n        if (def) def.style.display = 'none';\n      } else {\n        ov.hidden = true;\n        if (def) def.style.display = '';\n      }\n    });\n  }\n\n  // Targets the new anchor-wrapped images first\n  function updateImages(cardEl, urls) {\n    let imgs = cardEl.querySelectorAll('.media-thumb > img');\n    if (!imgs.length) imgs = cardEl.querySelectorAll('.card__media .media > img'); // fallback\n    if (!imgs.length) return;\n\n    imgs.forEach(function (img) {\n      if (!img.dataset.defaultSrc) {\n        img.dataset.defaultSrc    = img.getAttribute('src')    || '';\n        img.dataset.defaultSrcset = img.getAttribute('srcset') || '';\n      }\n    });\n\n    if (urls && urls.length) {\n      if (imgs[0]) { imgs[0].src = urls[0]; imgs[0].srcset = urls[0]; }\n      if (imgs[1]) {\n        const u = urls[1] || urls[0];\n        imgs[1].src = u; imgs[1].srcset = u;\n      }\n    } else {\n      imgs.forEach(function (img) {\n        if (img.dataset.defaultSrc)    img.src    = img.dataset.defaultSrc;\n        if (img.dataset.defaultSrcset) img.srcset = img.dataset.defaultSrcset;\n      });\n    }\n  }\n\n  function setActiveSwatch(btn) {\n    const list = btn.closest('.np-swatch-list');\n    if (!list) return;\n    list.querySelectorAll('.np-swatch').forEach(function (b) {\n      b.classList.remove('is-active');\n      b.setAttribute('aria-checked', 'false');\n    });\n    btn.classList.add('is-active');\n    btn.setAttribute('aria-checked', 'true');\n  }\n\n  function syncQuickAdd(wrapper, variantId) {\n    const hidden = wrapper.querySelector('input.product-variant-id');\n    if (hidden) hidden.value = variantId;\n  }\n\n  /* ---------- Tippy boot ---------- */\n  function ensureTippy(cb) {\n    if (window.tippy) return cb && cb();\n    var s = document.createElement('script');\n    s.src = 'https://unpkg.com/tippy.js@6/dist/tippy-bundle.umd.min.js';\n    s.async = true;\n    s.onload = function () { cb && cb(); };\n    document.head.appendChild(s);\n  }\n\n  function initTippyFor(container) {\n    if (!window.tippy || !container) return;\n    container.querySelectorAll('.np-swatch[data-tippy-content]').forEach(function (el) {\n      if (el._tippy) return;\n      window.tippy(el, {\n        content: el.getAttribute('data-tippy-content') || '',\n        theme: 'np',\n        placement: 'top',\n        arrow: true,\n        duration: [120, 80],\n        offset: [0, 10],\n        interactive: false,\n        allowHTML: false,\n        trigger: 'mouseenter focus',\n        appendTo: function () { return document.body; },\n        touch: ['hold', 300],\n      });\n    });\n  }\n\n  // Try to apply preferred selection; returns true if it clicked/updated something\n  function applyPreferred(wrapper) {\n    const picker = wrapper.querySelector('.np-card-variants');\n    const card   = wrapper.querySelector('.card');\n    if (!picker || !card) return false;\n\n    let preferredBtn = null;\n    NP_PREFERRED_VARIANTS.forEach(function (vid) {\n      if (!preferredBtn) {\n        const cand = picker.querySelector(`.np-swatch[data-variant-id=\"${vid}\"]:not(.is-disabled)`);\n        if (cand) preferredBtn = cand;\n      }\n    });\n    if (!preferredBtn) return false;\n\n    if (!preferredBtn.classList.contains('is-active')) {\n      // Use the same path as user interaction so everything syncs\n      preferredBtn.click();\n      return true;\n    } else {\n      // Already active — still ensure dependent UI is in sync\n      const urls  = (preferredBtn.dataset.images || '').split('|').filter(Boolean);\n      updateImages(wrapper, urls.length ? urls : null);\n      const vBadge = (preferredBtn.dataset.badgeOverride || '').trim();\n      const pBadge = (card.dataset.npInitialBadge || '').trim();\n      setBadgeOverride(card, vBadge || pBadge);\n      const vid = preferredBtn.dataset.variantId;\n      if (vid) syncQuickAdd(wrapper, vid);\n      return true;\n    }\n  }\n\n  function bindSwatchHandlers(wrapper) {\n    const card   = wrapper.querySelector('.card');\n    const picker = wrapper.querySelector('.np-card-variants');\n    if (!card || !picker) return;\n\n    // Click interactions\n    picker.addEventListener('click', function (e) {\n      const btn = e.target.closest('.np-swatch');\n      if (!btn || btn.classList.contains('is-disabled')) return;\n      e.preventDefault();\n\n      setActiveSwatch(btn);\n      const urls = (btn.dataset.images || '').split('|').filter(Boolean);\n      updateImages(wrapper, urls.length ? urls : null);\n\n      const vBadge = (btn.dataset.badgeOverride || '').trim();\n      const pBadge = (card.dataset.npInitialBadge || '').trim();\n      setBadgeOverride(card, vBadge || pBadge);\n\n      const vid = btn.dataset.variantId;\n      if (vid) syncQuickAdd(wrapper, vid);\n    }, { capture: true });\n\n    // Keyboard support\n    picker.addEventListener('keydown', function (e) {\n      const btn = e.target.closest('.np-swatch');\n      if (!btn || btn.classList.contains('is-disabled')) return;\n      if (e.key === 'Enter' || e.key === ' ') {\n        e.preventDefault();\n        btn.click();\n      }\n    }, { capture: true });\n  }\n\n  function initCard(wrapper) {\n    if (!wrapper) return;\n\n    // Avoid rebinding listeners; still allow re-applying preferred selection\n    const firstInit = wrapper.dataset.npScriptInit !== '1';\n    if (firstInit) {\n      wrapper.dataset.npScriptInit = '1';\n      bindSwatchHandlers(wrapper);\n      ensureTippy(function () { initTippyFor(wrapper); });\n    }\n\n    // 1) Try to apply preferred selection (Butter) first\n    const appliedPreferred = applyPreferred(wrapper);\n\n    // 2) If nothing preferred was applied, ensure initial active state sync\n    if (!appliedPreferred) {\n      const card   = wrapper.querySelector('.card');\n      const picker = wrapper.querySelector('.np-card-variants');\n      if (!card || !picker) return;\n\n      const active = picker.querySelector('.np-swatch.is-active') || picker.querySelector('.np-swatch:not(.is-disabled)');\n      if (active) {\n        const urls = (active.dataset.images || '').split('|').filter(Boolean);\n        updateImages(wrapper, urls.length ? urls : null);\n        const vBadge = (active.dataset.badgeOverride || '').trim();\n        const pBadge = (card.dataset.npInitialBadge || '').trim();\n        setBadgeOverride(card, vBadge || pBadge);\n        const vid = active.dataset.variantId;\n        if (vid) syncQuickAdd(wrapper, vid);\n      }\n    }\n  }\n\n  function initAll() {\n    document.querySelectorAll('.product-card-wrapper').forEach(initCard);\n\n    // Re-init when cards are added/updated (filters/AJAX)\n    new MutationObserver(function (muts) {\n      muts.forEach(function (m) {\n        m.addedNodes.forEach(function (n) {\n          if (n.nodeType !== 1) return;\n          if (n.matches && n.matches('.product-card-wrapper')) initCard(n);\n          n.querySelectorAll && n.querySelectorAll('.product-card-wrapper').forEach(initCard);\n          if (n.querySelectorAll) {\n            ensureTippy(function () {\n              document.querySelectorAll('.product-card-wrapper').forEach(initTippyFor);\n            });\n          }\n        });\n      });\n    }).observe(document.documentElement, { childList: true, subtree: true });\n\n    // If tippy loads later, bind once globally\n    ensureTippy(function () {\n      document.querySelectorAll('.product-card-wrapper').forEach(initTippyFor);\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initAll, { once: true });\n  } else {\n    initAll();\n  }\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 60,
        "padding_bottom": 0
      }
    }
