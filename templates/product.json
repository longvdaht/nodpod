        },
        "question_pHWbAj": {
          "type": "question",
          "settings": {
            "title": "What are the beads in Nodpod BODY made of? Are they safe?",
            "answer": "<p>Yes, they are safe. The beads are smooth, round, sand-like glass beads.</p>",
