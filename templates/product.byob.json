        "custom_liquid": "<style>\n/* ==========================================================================\n   BYOB – Hero banner (matches Figma node 15252:13252 + 15252:15793)\n   Scoped to this page's section only, so other .hero sections are untouched.\n   ========================================================================== */\n\n/* Section (width follows the theme's existing container) ------------------ */\n.hero[sid*=\"gs_hero_pJmaJU\"] {\n  --heroHeight: 314px;\n  position: relative;\n  height: 314px !important;\n  min-height: 0 !important;\n  border-radius: 0 !important;\n  overflow: hidden;\n}\n\n/* Background image -------------------------------------------------------- */\n.hero[sid*=\"gs_hero_pJmaJU\"] picture,\n.hero[sid*=\"gs_hero_pJmaJU\"] picture img {\n  position: absolute !important;\n  inset: 0;\n  width: 100% !important;\n  height: 100% !important;\n  max-width: none !important;\n}\n\n.hero[sid*=\"gs_hero_pJmaJU\"] picture img {\n  object-fit: cover;\n  object-position: center 40%;\n}\n\n/* Text layer -------------------------------------------------------------- */\n.hero[sid*=\"gs_hero_pJmaJU\"] .meta {\n  position: absolute !important;\n  inset: 0;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 0 28px !important;\n  background: none !important;\n}\n\n.hero[sid*=\"gs_hero_pJmaJU\"] .meta .box,\n.hero[sid*=\"gs_hero_pJmaJU\"] .meta .content {\n  width: 100%;\n  max-width: 496px;            /* Figma text frame width */\n  margin: 0 auto;\n  padding: 0 !important;\n  background: none !important;\n}\n\n.hero[sid*=\"gs_hero_pJmaJU\"] .meta x-flex[direction=\"column\"] {\n  gap: 12px !important;\n}\n\n/* Heading: Larken Light 32 / 41, white */\n.hero[sid*=\"gs_hero_pJmaJU\"] .section-main-heading-hero {\n  margin: 0 !important;\n  font-family: larken, serif !important;\n  font-weight: 300 !important;\n  font-style: normal !important;\n  font-size: 32px !important;\n  line-height: 41px !important;\n  letter-spacing: 0.32px !important;\n  text-transform: none !important;\n  text-align: center !important;\n  color: #FFFFFF !important;\n  background: none !important;\n}\n\n/* Smaller ® if wrapped in <sup> in the heading setting */\n.hero[sid*=\"gs_hero_pJmaJU\"] .section-main-heading-hero sup {\n  font-size: 0.645em;          /* 20.64 / 32 */\n  vertical-align: super;\n  line-height: 0;\n}\n\n/* Subtitle: Poppins Regular 16, white */\n.hero[sid*=\"gs_hero_pJmaJU\"] .section-main-text {\n  margin: 0 !important;\n  font-family: poppins, sans-serif !important;\n  font-weight: 400 !important;\n  font-size: 16px !important;\n  line-height: 24px !important;\n  letter-spacing: 0.16px !important;\n  text-align: center !important;\n  color: #FFFFFF !important;\n}\n\n/* Mobile ------------------------------------------------------------------ */\n@media (max-width: 749px) {\n  .hero[sid*=\"gs_hero_pJmaJU\"] {\n    --heroHeight: 220px;\n    height: 220px !important;\n  }\n\n  .hero[sid*=\"gs_hero_pJmaJU\"] .section-main-heading-hero {\n    font-size: 26px !important;\n    line-height: 32px !important;\n  }\n\n  .hero[sid*=\"gs_hero_pJmaJU\"] .section-main-text {\n    font-size: 14px !important;\n    line-height: 20px !important;\n  }\n}\n\n</style>",
