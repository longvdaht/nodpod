    "custom_liquid_CXzdKx": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* ==========================================================================\n   BYOB – Sticky bundle summary bar\n   Layout (desktop):  [ item · item · item ]  |  Total ~~orig~~ NEW [10% OFF]  [ Add to Cart ]\n   Styled after the Figma slots + summary box:\n   slots 14px radius / #EBEAE6 · summary #FAFAF9, Poppins · pill #A2B0A5\n   button #636666, Larken Italic, white, square\n\n   Prefixed with `.byob-footer.byob-footer` (doubled class) so it out-ranks\n   the app's styles without !important. Fixed/sticky positioning is left\n   to the app.\n   ========================================================================== */\n\n/* Bar – full-bleed background, content aligned to a 1290px container ------ */\n.byob-footer.byob-footer {\n  display: flex;\n  align-items: center;\n  gap: 32px;\n  box-sizing: border-box;\n  width: 100%;\n  max-width: none;\n  margin: 0;\n  padding: 14px max(24px, calc((100% - 1290px) / 2));\n  padding-right: max(64px, calc((100% - 1290px) / 2));  /* room for ⌄ */\n  background: #FAFAF9;\n  border: 0;\n  border-top: 1px solid #EBEAE6;\n  border-radius: 0;\n  box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.06);\n  font-family: poppins, sans-serif;\n  color: #5D5E5D;\n}\n\n/* Selected items ---------------------------------------------------------- */\n.byob-footer.byob-footer .byob-footer-left {\n  flex: 1 1 auto;\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n  overflow-x: auto;\n  scrollbar-width: none;\n}\n\n.byob-footer.byob-footer .byob-footer-left::-webkit-scrollbar {\n  display: none;\n}\n\n.byob-footer.byob-footer .byob-wrapper {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  /* Centred; when there are too many items to fit, the auto margins\n     collapse to 0 so the row starts at the left and scrolls */\n  width: max-content;\n  margin: 0 auto;\n  padding: 10px 11px 6px;            /* room for the overhanging ✕ */\n}\n\n/* Each item = a soft \"chip\": thumbnail + name */\n.byob-footer.byob-footer .byob-footer-card {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex: 0 0 auto;\n  width: 230px;\n  max-width: 230px;\n  margin: 0;\n  padding: 6px 12px 6px 6px;\n  box-sizing: border-box;\n  background: #FFFFFF;\n  border: 1px solid #EBEAE6;\n  border-radius: 14px;\n}\n\n.byob-footer.byob-footer .byob-footer-thumbnail {\n  position: static;                  /* ✕ + qty anchor to the card */\n  flex: none;\n  width: 56px;\n  height: 56px;\n  margin: 0;\n  padding: 0;\n}\n\n.byob-footer.byob-footer .byob-footer-thumbnail-image {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: #FAFAF9;\n  border-radius: 10px;\n}\n\n.byob-footer.byob-footer .byob-footer-thumbnail-image img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  max-width: none;\n  margin: 0;\n  object-fit: cover;\n}\n\n/* Remove (✕) – white circle on the chip's top-right corner */\n.byob-footer.byob-footer .byob-close {\n  position: absolute;\n  top: -11px;\n  right: -11px;\n  left: auto;\n  z-index: 2;\n  width: 30px;\n  height: 30px;\n  margin: 0;\n  padding: 0;\n  cursor: pointer;\n}\n\n.byob-footer.byob-footer .byob-footer-remove-icon {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n\n.byob-footer.byob-footer .byob-footer-remove-icon circle {\n  fill: #FFFFFF;\n  stroke: #D9D8D3;\n  stroke-width: 1;\n}\n\n.byob-footer.byob-footer .byob-footer-remove-icon path {\n  stroke: #636666;\n}\n\n.byob-footer.byob-footer .byob-close:hover .byob-footer-remove-icon circle {\n  fill: #636666;\n  stroke: #636666;\n}\n\n.byob-footer.byob-footer .byob-close:hover .byob-footer-remove-icon path {\n  stroke: #FFFFFF;\n}\n\n/* Name */\n.byob-footer.byob-footer .byob-footer-thumbnail-detail {\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n}\n\n.byob-footer.byob-footer .byob-footer-thumbnail-detail .card-title {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n  overflow: hidden;\n  margin: 0;\n  font-family: poppins, sans-serif;\n  font-weight: 400;\n  font-size: 12px;\n  line-height: 17px;\n  letter-spacing: 0.12px;\n  color: #5D5E5D;\n}\n\n/* Qty (\"x 2\") → small badge on the thumbnail's bottom-left corner */\n.byob-footer.byob-footer .byob-footer-thumbnail-detail > div {\n  position: absolute;\n  left: 10px;\n  bottom: 10px;\n  z-index: 1;\n  min-width: 22px;\n  padding: 0 6px;\n  box-sizing: border-box;\n  font-family: poppins, sans-serif;\n  font-weight: 600;\n  font-size: 10px;\n  line-height: 18px;\n  text-align: center;\n  color: #FFFFFF;\n  background: #636666;\n  border-radius: 20px;\n}\n\n/* Summary – Total + button ------------------------------------------------ */\n.byob-footer.byob-footer .flex-item-right {\n  display: flex;\n  align-items: center;\n  gap: 24px;\n  flex: none;\n  margin: 0;\n  padding: 0 0 0 32px;\n  border-left: 1px solid #EBEAE6;\n}\n\n.byob-footer.byob-footer #label-total-price {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 4px 10px;\n  margin: 0;\n  font-family: poppins, sans-serif;\n  font-weight: 400;\n  font-size: 14px;\n  line-height: 24px;\n  letter-spacing: 0.14px;\n  white-space: nowrap;\n  color: #5D5E5D;\n}\n\n/* Original price – struck through, muted */\n.byob-footer.byob-footer #byob-total-price {\n  font-size: 14px;\n  font-weight: 400;\n  color: #75787B;\n  text-decoration: line-through;\n}\n\n/* Bundle price */\n.byob-footer.byob-footer #byob-bundle-price {\n  font-size: 18px;\n  font-weight: 600;\n  color: #404040;\n}\n\n.byob-footer.byob-footer .lb-currency-code {\n  display: none;\n}\n\n/* Sage discount pill, as in the design's summary box.\n   Static text – the bundle discount is a flat 10%. */\n.byob-footer.byob-footer #label-total-price::after {\n  content: \"10% OFF\";\n  display: inline-block;\n  padding: 0 10px;\n  font-family: poppins, sans-serif;\n  font-weight: 600;\n  font-size: 11px;\n  line-height: 22px;\n  letter-spacing: 0.44px;\n  color: #FFFFFF;\n  background: #A2B0A5;\n  border-radius: 20px;\n}\n\n/* Add to Cart / \"Add X more…\" */\n.byob-footer.byob-footer #btn-add-to-cart {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 240px;\n  height: 52px;\n  margin: 0;\n  padding: 0 28px;\n  background: #636666;\n  border: 1px solid #636666;\n  border-radius: 0;\n  box-shadow: none;\n  opacity: 1;\n  cursor: pointer;\n  transition: background-color 0.2s ease, opacity 0.2s ease;\n}\n\n.byob-footer.byob-footer #btn-add-to-cart::before,\n.byob-footer.byob-footer #btn-add-to-cart::after {\n  display: none;\n}\n\n.byob-footer.byob-footer #btn-add-to-cart,\n.byob-footer.byob-footer #btn-add-to-cart span {\n  font-family: larken, serif;\n  font-style: italic;\n  font-weight: 400;\n  font-size: 19px;\n  line-height: 1;\n  letter-spacing: 0.19px;\n  text-transform: none;\n  white-space: nowrap;\n  color: #FFFFFF;\n}\n\n.byob-footer.byob-footer #btn-add-to-cart:hover:not(:disabled) {\n  background: #4F5252;\n  border-color: #4F5252;\n}\n\n/* Incomplete bundle – outline style so it reads as \"not ready yet\" */\n.byob-footer.byob-footer #btn-add-to-cart:disabled {\n  background: transparent;\n  border-color: #B9BABA;\n  opacity: 1;\n  cursor: not-allowed;\n}\n\n.byob-footer.byob-footer #btn-add-to-cart:disabled span {\n  color: #8C8E8E;\n}\n\n/* Minimise arrow – top-right of the bar */\n.byob-footer.byob-footer #hide-footer-button {\n  width: 22px;\n  height: 22px;\n  color: #75787B;\n  cursor: pointer;\n}\n\n.byob-footer.byob-footer #hide-footer-button:hover {\n  color: #404040;\n}\n\n.byob-footer.byob-footer #hide-footer-button svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  stroke: currentColor;\n}\n\n/* Tablet – items on top, summary row below ------------------------------- */\n@media (max-width: 989px) {\n  .byob-footer.byob-footer {\n    flex-direction: column;\n    align-items: stretch;\n    gap: 10px;\n    padding: 12px 16px 14px;\n  }\n\n  .byob-footer.byob-footer .byob-footer-left {\n    width: 100%;\n    padding: 0 32px;                   /* keep clear of ⌄, symmetric so centring stays true */\n    box-sizing: border-box;\n  }\n\n  .byob-footer.byob-footer .flex-item-right {\n    width: 100%;\n    justify-content: center;\n    gap: 24px;\n    padding: 12px 0 0;\n    border-left: 0;\n    border-top: 1px solid #EBEAE6;\n  }\n\n  .byob-footer.byob-footer #btn-add-to-cart {\n    flex: 0 1 320px;\n    min-width: 0;\n    height: 48px;\n  }\n}\n\n/* Mobile – thumbnails only, stacked summary ------------------------------ */\n@media (max-width: 749px) {\n  .byob-footer.byob-footer .byob-wrapper {\n    gap: 10px;\n  }\n\n  /* Drop the chip + name; just the thumbnail */\n  .byob-footer.byob-footer .byob-footer-card {\n    width: auto;\n    max-width: none;\n    padding: 0;\n    background: transparent;\n    border: 0;\n  }\n\n  .byob-footer.byob-footer .byob-footer-thumbnail {\n    width: 52px;\n    height: 52px;\n  }\n\n  .byob-footer.byob-footer .byob-footer-thumbnail-image {\n    border: 1px solid #EBEAE6;\n    box-sizing: border-box;\n  }\n\n  .byob-footer.byob-footer .byob-footer-thumbnail-detail .card-title {\n    display: none;\n  }\n\n  .byob-footer.byob-footer .byob-footer-thumbnail-detail > div {\n    left: 4px;\n    bottom: 4px;\n  }\n\n  .byob-footer.byob-footer .byob-close {\n    top: -10px;\n    right: -10px;\n    width: 26px;\n    height: 26px;\n  }\n\n  .byob-footer.byob-footer .flex-item-right {\n    flex-direction: column;\n    align-items: stretch;\n    gap: 10px;\n  }\n\n  .byob-footer.byob-footer #label-total-price {\n    justify-content: flex-start;\n  }\n\n  .byob-footer.byob-footer #btn-add-to-cart {\n    flex: none;\n    width: 100%;\n    height: 46px;\n  }\n\n  .byob-footer.byob-footer #btn-add-to-cart,\n  .byob-footer.byob-footer #btn-add-to-cart span {\n    font-size: 17px;\n  }\n}\n\n</style>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
