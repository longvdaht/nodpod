{% comment %}
  Launch / collab category section.

  One promo tile (category title + "Shop All") sits in the first grid cell, followed by
  one product card PER VARIANT (no swatches) for every variant in the chosen collection
  that passes the launch-group filter. Stack several of these sections on one page
  (e.g. Cotton / Silk / BODY) to build a launch landing page; with zero vertical padding
  they read as one continuous grid.

  Variant visibility mirrors np-product-grid / card-product:
  - live: variant must be release-ready (release.ready or custom.release_ready)
  - editor / preview: every variant shows
  - launch filter: variant's custom.launch_group must contain the filter value
{% endcomment %}

{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #shopify-section-{{ section.id }} .np-launch-tile {
    --tile-text: {{ section.settings.tile_text_color }};
    --tile-bg: {{ section.settings.tile_bg_color }};
    --tile-overlay: {{ section.settings.tile_overlay | divided_by: 100.0 }};
  }
{%- endstyle -%}

{%- liquid
  assign grid_collection = section.settings.collection
  assign launch_filter = section.settings.launch_group_filter

  assign filter_handle = ''
  if launch_filter != blank
    assign filter_handle = launch_filter | handleize
  endif

  assign staff_view = false
  if request.design_mode
    assign staff_view = true
  elsif content_for_header contains 'previewBarInjector'
    assign staff_view = true
  endif

  assign max_cards = section.settings.max_cards
-%}

<div class="np-launch-category color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="collection page-width">
      <ul
        id="launch-grid-{{ section.id }}"
        class="grid product-grid grid--2-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
      >
        {%- if section.settings.show_tile -%}
          <li class="grid__item np-launch-tile-item">
            {%- liquid
              assign tile_tag = 'div'
              if section.settings.tile_link != blank
                assign tile_tag = 'a'
              endif
            -%}
            <{{ tile_tag }}
              class="np-launch-tile"
              {% if section.settings.tile_link != blank %}
                href="{{ section.settings.tile_link }}"
              {% endif %}
            >
              {%- if section.settings.tile_image != blank -%}
                <picture class="np-launch-tile__media">
                  {%- if section.settings.tile_image_mobile != blank -%}
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ section.settings.tile_image_mobile | image_url: width: 500 }} 500w, {{ section.settings.tile_image_mobile | image_url: width: 800 }} 800w"
                      sizes="50vw"
                    >
                  {%- endif -%}
                  {{
                    section.settings.tile_image
                    | image_url: width: 1100
                    | image_tag:
                      widths: '360, 533, 720, 940, 1100',
                      sizes: '(min-width: 990px) 33vw, 50vw',
                      alt: section.settings.tile_title,
                      loading: 'lazy'
                  }}
                </picture>
              {%- endif -%}

              <div class="np-launch-tile__content">
                {%- if section.settings.tile_title != blank -%}
                  <h2 class="np-launch-tile__title">{{ section.settings.tile_title | escape }}</h2>
                {%- endif -%}
                {%- if section.settings.tile_button_label != blank -%}
                  <span class="np-launch-tile__button">{{ section.settings.tile_button_label | escape }}</span>
                {%- endif -%}
              </div>
            </{{ tile_tag }}>
          </li>
        {%- endif -%}

        {%- assign rendered_count = 0 -%}
        {%- assign skip_card_product_styles = false -%}

        {%- if grid_collection != blank -%}
          {%- for product in grid_collection.products -%}
            {%- if rendered_count >= max_cards -%}{%- break -%}{%- endif -%}
            {%- for v in product.variants -%}
              {%- if rendered_count >= max_cards -%}{%- break -%}{%- endif -%}
              {%- liquid
                assign rr1 = v.metafields.release.ready.value
                assign rr2 = v.metafields.custom.release_ready.value
                assign ready_true = false
                if rr1 == true or rr1 == 'true' or rr1 == 1 or rr1 == '1'
                  assign ready_true = true
                elsif rr2 == true or rr2 == 'true' or rr2 == 1 or rr2 == '1'
                  assign ready_true = true
                endif

                assign variant_visible = false
                if staff_view or ready_true or section.settings.ignore_release_ready
                  assign variant_visible = true
                endif

                if filter_handle != blank
                  assign v_launch_joined = v.metafields.custom.launch_group.value | join: '||'
                  assign v_launch_list = v_launch_joined | split: '||'
                  assign v_in_launch = false
                  for lg in v_launch_list
                    assign lg_handle = lg | strip | handleize
                    if lg_handle == filter_handle
                      assign v_in_launch = true
                      break
                    endif
                  endfor
                  unless v_in_launch
                    assign variant_visible = false
                    assign skip_reason = 'launch_group is "' | append: v_launch_joined | append: '"'
                  endunless
                endif

                if section.settings.hide_sold_out and v.available == false
                  assign variant_visible = false
                  assign skip_reason = 'sold out ("Hide sold-out variants" is on)'
                endif
              -%}
              {%- comment -%} Staff-only HTML comment (view source / inspect) explaining hidden variants. {%- endcomment -%}
              {%- if staff_view and variant_visible == false -%}
                <!-- np-launch-category: hidden {{ product.title | escape }} / {{ v.title | escape }} (ID {{ v.id }}): {{ skip_reason | escape }} -->
              {%- endif -%}
              {%- assign skip_reason = '' -%}
              {%- if variant_visible -%}
                {%- assign rendered_count = rendered_count | plus: 1 -%}
                {%- assign lazy_load = true -%}
                {%- if rendered_count <= 2 -%}{%- assign lazy_load = false -%}{%- endif -%}
                <li class="grid__item">
                  {% render 'card-product',
                    card_product: product,
                    card_variant: v,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: 'default',
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: false,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    mobile_atc_label: section.settings.mobile_atc_label,
                    section_id: section.id,
                    launch_filter: launch_filter
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- if staff_view and rendered_count == 0 -%}
        <p class="np-launch-category__empty">
          {%- if grid_collection == blank -%}
            Select a collection for this section.
          {%- else -%}
            No variants in "{{ grid_collection.title }}" match the launch group "{{ launch_filter }}". Check the
            variants' Launch group metafield, or clear the "Launch group" setting. (Only staff see this message.)
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  /* Yotpo's card widget prints "1278 Reviews". The design wants "(1,278)".
     Yotpo renders client-side, so reformat once its text appears. Scoped to this
     section type only; other product cards keep Yotpo's default text. */
  (function () {
    if (window.npLaunchYotpoFormat) return;
    window.npLaunchYotpoFormat = true;

    var SELECTOR = '.np-launch-category .yotpo-sr-bottom-line-text';

    function format(el) {
      var text = (el.textContent || '').trim();
      if (!text || text.charAt(0) === '(') return; // already formatted
      var match = text.replace(/,/g, '').match(/\d+/);
      if (!match) return;
      el.textContent = '(' + Number(match[0]).toLocaleString('en-US') + ')';
    }

    function run() {
      document.querySelectorAll(SELECTOR).forEach(format);
    }

    function start() {
      run();
      var pending = false;
      new MutationObserver(function () {
        if (pending) return;
        pending = true;
        requestAnimationFrame(function () {
          pending = false;
          run();
        });
      }).observe(document.body, { childList: true, subtree: true, characterData: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>

<style>
  .np-launch-tile-item { display: flex; }
  .np-launch-tile {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 32rem;
    border-radius: 8px;
    overflow: hidden;
    background: var(--tile-bg);
    color: var(--tile-text);
    text-decoration: none;
  }
  .np-launch-tile__media,
  .np-launch-tile__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .np-launch-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--tile-overlay));
    pointer-events: none;
  }
  .np-launch-tile__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    padding: 2rem;
  }
  .np-launch-tile__title {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading-family);
    font-weight: 300;
    font-size: 5rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .np-launch-tile__button {
    display: block;
    height: 4.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid currentColor;
    text-align: center;
    font-family: var(--font-heading-family);
    font-style: italic;
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: 0;
    transition: background-color 0.2s ease;
  }
  a.np-launch-tile:hover .np-launch-tile__button { background: rgba(255, 255, 255, 0.15); }
  a.np-launch-tile:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .np-launch-category__empty { text-align: center; padding: 2rem 0; }

  @media screen and (max-width: 989px) {
    .np-launch-tile__title { font-size: 3rem; }
  }
  @media screen and (max-width: 749px) {
    .np-launch-tile { min-height: 24rem; }
    .np-launch-tile__content { padding: 1.6rem; gap: 1.6rem; }
    .np-launch-tile__title { font-size: 3rem; }
  }
</style>

{% schema %}
{
  "name": "NP Launch Category",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "settings": [
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "text",
      "id": "launch_group_filter",
      "label": "Launch group",
      "placeholder": "e.g. Mid Century Merry",
      "info": "Only variants whose \"Launch group\" metafield contains this value are shown, one card per variant. Leave blank to show every variant in the collection."
    },
    {
      "type": "range",
      "id": "max_cards",
      "min": 2,
      "max": 50,
      "step": 1,
      "default": 24,
      "label": "Maximum cards"
    },
    { "type": "checkbox", "id": "hide_sold_out", "label": "Hide sold-out variants", "default": false },
    {
      "type": "checkbox",
      "id": "ignore_release_ready",
      "label": "Show variants that are not release-ready",
      "default": false,
      "info": "For review before launch only. When on, customers can see variants whose release-ready metafield is not set. Turn off before launch."
    },

    { "type": "header", "content": "Category tile" },
    { "type": "checkbox", "id": "show_tile", "label": "Show category tile", "default": true },
    { "type": "image_picker", "id": "tile_image", "label": "Image", "info": "Portrait, around 800 × 1100px" },
    { "type": "image_picker", "id": "tile_image_mobile", "label": "Mobile image (optional)" },
    { "type": "text", "id": "tile_title", "label": "Title", "default": "Category title" },
    { "type": "text", "id": "tile_button_label", "label": "Button label", "default": "Shop All" },
    { "type": "url", "id": "tile_link", "label": "Link" },
    { "type": "color", "id": "tile_text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "tile_bg_color", "label": "Background color", "default": "#8E2A2A", "info": "Shows when no image is set." },
    {
      "type": "range",
      "id": "tile_overlay",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 0
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },

    { "type": "header", "content": "Product card" },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "square",
      "label": "Image ratio"
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Show second variant image on hover", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show product rating", "default": true },
    {
      "type": "select",
      "id": "quick_add",
      "default": "standard",
      "label": "Quick add",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" }
      ]
    },
    {
      "type": "text",
      "id": "mobile_atc_label",
      "label": "Add to cart label on mobile",
      "default": "Add",
      "info": "Shorter button text on phones. Leave blank to keep the full label."
    },

    { "type": "header", "content": "Padding – desktop" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    { "type": "header", "content": "Padding – mobile" },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [{ "name": "NP Launch Category" }]
}
{% endschema %}
