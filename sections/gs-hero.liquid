{%- liquid
  assign firstBlock = section.blocks[0]
  assign isImageFirst = false
  assign isVideoFirst = false
  # assign isVideoExternalFirst = false
  assign blockName = null
  assign videoHeight = null

  case firstBlock.type
    when 'image'
      assign isImageFirst = true
    when 'video'
      assign isVideoFirst = true
      assign blockName = 'html5video'
      if section.settings.cropVideo
        assign videoHeight = '--vidCropO:hidden;--vidCropH:var(--heroHeight);'
      endif
    when 'video_external'
      # assign isVideoExternalFirst = true
      assign blockName = 'externalvideo'
  endcase
-%}

{%- liquid
  capture style
    echo section.settings.heroMetaH1Bg | prepend: '--heroMetaH1Bg:' | append: ';'
    echo section.settings.heroMetaH1Color | prepend: '--heroMetaH1Color:' | append: ';'

    assign heroHeight = section.settings.heroHeight
    if section.settings.heroHeight == 'uncropped'
      assign heroHeight = 'var(--heroHeight-f)'
    endif
    echo heroHeight | prepend: '--heroHeight:' | append: ';'

    echo videoHeight
  endcapture
-%}

<style>
  /* Utility classes for x-flex/x-grid layout (scoped to this section's needs) */
  .hero[sid="{{ section.id }}"] :where(x-flex,[x-flex]) {
    display: flex;
    gap: var(--rowGap, 1rem) var(--columnGap, 1rem);
  }

  .hero[sid="{{ section.id }}"] x-flex[direction="column"] { flex-direction: column; }
  .hero[sid="{{ section.id }}"] x-flex[direction="row"] { flex-direction: row; }
  .hero[sid="{{ section.id }}"] x-flex[orientation="column"] { flex-direction: column; }
  .hero[sid="{{ section.id }}"] x-flex[orientation="row"] { flex-direction: row; }

  .hero[sid="{{ section.id }}"] x-flex[ai="start"] { align-items: flex-start; }
  .hero[sid="{{ section.id }}"] x-flex[ai="center"] { align-items: center; }
  .hero[sid="{{ section.id }}"] x-flex[ai="end"] { align-items: flex-end; }

  .hero[sid="{{ section.id }}"] x-flex[pi="center"] {
    align-items: center;
    justify-content: center;
  }

  .hero[sid="{{ section.id }}"] x-flex[pi="top left"] {
    align-items: flex-start;
    justify-content: flex-start;
  }

  .hero[sid="{{ section.id }}"] x-flex[pi="top center"] {
    align-items: flex-start;
    justify-content: center;
  }

  .hero[sid="{{ section.id }}"] x-flex[pi="center between"] {
    align-items: center;
    justify-content: space-between;
  }

  @media (max-width: 777px) {
    .hero[sid="{{ section.id }}"] x-flex[direction-s="column"] { flex-direction: column; }
    .hero[sid="{{ section.id }}"] x-flex[orientation-s="column"] { flex-direction: column; }

    .hero[sid="{{ section.id }}"] x-flex[ai-s="start"] { align-items: flex-start; }
    .hero[sid="{{ section.id }}"] x-flex[ai-s="center"] { align-items: center; }
    .hero[sid="{{ section.id }}"] x-flex[ai-s="end"] { align-items: flex-end; }

    .hero[sid="{{ section.id }}"] x-flex[pi-s="top center"] {
      align-items: flex-start;
      justify-content: center;
    }

    .hero[sid="{{ section.id }}"] x-flex[pi-s="center between"] {
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Section-specific heading style */
  .hero[sid="{{ section.id }}"] .section-main-heading-hero {
    font-family: larken;
    font-weight: 300;
    font-size: 7.5rem;
    line-height: 1.15;
    margin-bottom: 30px;
    margin-top: 0;
  }

  /* Scoped styles for gs-hero section */
  .hero[sid="{{ section.id }}"] { 
    --heroHeight-s: 480px;
    --heroHeight-m: 560px;
    --heroHeight-l: 720px;
    --heroHeight-f: 93vh;

    position: relative; 
    height: var(--heroHeight, 100vh);
    width: 100%;
    aspect-ratio: 2;

    border-block-end: var(--globalBorder); 
    overflow: hidden;
  }

  .hero[sid="{{ section.id }}"] picture { height: 100%; }
  .hero[sid="{{ section.id }}"] picture svg { height: 100%; }

  .hero[sid="{{ section.id }}"] picture img { 
    position: absolute; 
    inset: 0; 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    object-position: center;
  }

  .hero[sid="{{ section.id }}"] .meta {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 88;
    width: 100%;
    height: 100%;
    padding: calc(2rem * 3);
    pointer-events: var(--heroMetaPointerEvents, all);
  }

  .hero[sid="{{ section.id }}"] .meta [ai="start"] { text-align: start; }
  .hero[sid="{{ section.id }}"] .meta [ai="center"] { text-align: center; }
  .hero[sid="{{ section.id }}"] .meta [ai="end"] { text-align: end; }

  .hero[sid="{{ section.id }}"] .meta x-grid { height: 100%; }

  .hero[sid="{{ section.id }}"] .meta a { text-decoration: none; border: 0; }
  .hero[sid="{{ section.id }}"] .meta :where(h2,p) { 
    color: var(--heroMetaH1Color); 
    --linkColor: var(--heroMetaH1Color); 
    --linkHover: var(--heroMetaH1Color);
  }
  
  .hero[sid="{{ section.id }}"] .hasBg { 
    display: inline; 
    padding: var(--margin); 
    background: var(--heroMetaH1Bg); 
    border-radius: calc(var(--radius) / 7);
  }
  
  .hero[sid="{{ section.id }}"] .button.is-customized { 
    --buttonBgColor: var(--heroMetaH1Bg); 
    --buttonColor: var(--heroMetaH1Color);
  }

  .hero[sid="{{ section.id }}"] .meta .box { 
    width: 100%; 
    height: 100%; 
  }

  /* html5video */
  .hero[sid="{{ section.id }}"].html5video { overflow: var(--vidCropO, visible); height: var(--vidCropH, fit-content); }
  .hero[sid="{{ section.id }}"].html5video .meta { pointer-events: none; }
  .hero[sid="{{ section.id }}"].html5video .meta .button { pointer-events: all; }
  .hero[sid="{{ section.id }}"].html5video video { width: 100vw; }

  /* video player */
  .hero[sid="{{ section.id }}"] video-player {
    --iconSize: 28px;
    --vp-margin: 2rem;
    --vp-padding: 0.5rem;
    display: grid; 
    grid-template-rows: 1fr; 
    grid-template-columns: 1fr;
  }
  .hero[sid="{{ section.id }}"] video-player > * { position: relative; grid-row: 1; grid-column: 1; }
  .hero[sid="{{ section.id }}"] video-player video { width: 100%; object-fit: cover; }

  .hero[sid="{{ section.id }}"] video-player button.controller { 
    --buttonPadding: var(--vp-padding); 
    width: fit-content; 
    display: grid; 
    grid-template-rows: 1fr; 
    grid-template-columns: 1fr; 
    place-self: end; 
    margin: var(--vp-margin); 
  }
  .hero[sid="{{ section.id }}"] video-player button.controller > * { position: relative; grid-row: 1; grid-column: 1; }

  .hero[sid="{{ section.id }}"] video-player button.controller { transition: all 200ms ease-in-out; }
  .hero[sid="{{ section.id }}"] video-player.playing button.controller { opacity: 0; transform: scale(0); }
  .hero[sid="{{ section.id }}"] video-player.playing:hover button.controller { opacity: 1; transform: none; }
  .hero[sid="{{ section.id }}"] video-player.playing button.controller:focus { opacity: 1; transform: none; }

  .hero[sid="{{ section.id }}"] video-player button.controller[hidden] { display: none!important; }

  .hero[sid="{{ section.id }}"] video-player button.controller .pause-icon, 
  .hero[sid="{{ section.id }}"] video-player.playing button.controller .play-icon { opacity: 0; }
  .hero[sid="{{ section.id }}"] video-player.playing button.controller .pause-icon, 
  .hero[sid="{{ section.id }}"] video-player button.controller .play-icon { opacity: 1; }

  .hero[sid="{{ section.id }}"] video-player .video-progress {
    --vp-progress: 0%;
    position: absolute;
    inset: var(--vp-progress-inset, 0.2rem 0.5rem);
    z-index: 1;
    width: var(--vp-progress-width, 100vw);
    height: var(--vp-progress-height, 8px);
    border-radius: var(--vp-progress-radius, 100vw);
    background: var(--vp-progress-bg);
  }

  .hero[sid="{{ section.id }}"] video-player .video-progress::after {
    content: '';
    display: block;
    background-color: var(--vp-progress-fg, rgb(0 0 0 / 0.4));
    border-radius: inherit;
    height: 100%;
    width: var(--vp-progress);
    transition: width 500ms ease;
  }

  /* Mobile styles */
  @media (max-width: 777px) { 
    .hero[sid="{{ section.id }}"] { 
      height: 600px;
    }
    .hero[sid="{{ section.id }}"] .meta { padding: calc(2rem * 1.7) calc(2rem * 1.3); } 
    .hero[sid="{{ section.id }}"] .meta .box { height: auto; }

    .hero[sid="{{ section.id }}"] .meta [ai-s="start"] { text-align: start; }
    .hero[sid="{{ section.id }}"] .meta [ai-s="center"] { text-align: center; }
    .hero[sid="{{ section.id }}"] .meta [ai-s="end"] { text-align: end; }

    .hero[sid="{{ section.id }}"] video-player { --vp-icon: 23px; --vp-margin: 0.5rem; --vp-padding: 0.2rem; }
  }

  /* Uncropped mode */
  {%- if section.settings.heroHeight == 'uncropped' -%}
    @media (min-width:778px) { 
      .hero[sid="{{ section.id }}"] { 
        --heroHeight-f: auto!important; 
        aspect-ratio: initial; 
        overflow: visible; 
      } 
      .hero[sid="{{ section.id }}"] picture img { 
        all: unset; 
        display: block; 
        width: 100%; 
      } 
    }
  {%- endif -%}
</style>

<section
  class="hero {{ blockName }}"
  style="{{ style }}"
  sid="{{ section.id }}"
  data-block-id="{{ section.settings.block_id }}"
>
  {% for block in section.blocks %}
    {%- case block.type -%}
      {%- when 'image' -%}
        {%- if isImageFirst -%}
          {%- if block.settings.imgClickable and section.settings.url != empty %}
            <style>
              .hero[sid="{{ section.id }}"] { --heroMetaPointerEvents: none }
            </style>
            <a href="{{ section.settings.url }}" class="no-style" tabindex="-1">
          {%- endif -%}
          <picture>
            {%- assign imgMobile = block.settings.imageMobile -%}
            {%- assign imgDesktop = block.settings.image -%}

            {%- if imgDesktop != null or imgMobile != null -%}
              {%- if imgMobile != null -%}
                <source
                  srcset="{{ imgMobile | image_url: width: 970 }} 1x, {{ imgMobile | image_url: width: 1280 }} 2x"
                  media="(max-width:777px)"
                >
              {%- endif -%}
              {%- liquid
                assign width = 2750
                assign widths = '750,1000,1280,1500,1750,2000,2500,2750'
                render 'global-img', img: imgDesktop, alt: section.settings.title, width: width, widths: widths
              -%}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'svg-placeholder' }}
            {%- endif -%}
          </picture>
          {%- if block.settings.imgClickable and section.settings.url != empty -%}</a>{%- endif -%}
        {%- endif -%}

      {%- when 'video' -%}
        {%- if isVideoFirst -%}
          {%- liquid
            assign vid = block.settings.video
            assign vidMobile = block.settings.videoMobile | default: null

            assign loop = block.settings.videoLoop
            assign autoplay = block.settings.videoAutoplay
            assign muted = block.settings.videoMute
            assign clickToPlay = block.settings.clickToPlay
            assign controls = block.settings.playPause

            render 'global-video', vid: vid, vidMobile: vidMobile, loop: loop, autoplay: autoplay, muted: muted, clickToPlay: clickToPlay, controls: controls
          -%}
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}

  <div
    class="meta"
    {%- if section.settings.imgClickable and section.settings.url != empty -%}
      style="pointer-events:none"
    {%- endif -%}
  >
    <x-flex
      class="box"
      pi="{{ section.settings.contentPosition }}"
      pi-s="{{ section.settings.contentPositionMob }}"
      orientation="{{ section.settings.contentDirection }}"
      orientation-s="{{ section.settings.contentDirectionMob }}"
    >
      <x-cell class="content">
        <x-flex
          direction="{{ section.settings.contentDirection }}"
          direction-s="{{ section.settings.contentDirectionMob }}"
          ai="{{ section.settings.textAlignment | replace: 'left', 'start' | replace: 'right', 'end' }}"
          ai-s="{{ section.settings.textAlignmentMob | replace: 'left', 'start' | replace: 'right', 'end' }}"
          style="gap:10px;"
        >
          {%- if section.settings.subtitle != empty -%}
            <x-cell>
              <p
                class="section-subheading{% if section.settings.heroMetaH1hasBg == true %} hasBg{% endif %}"
              >
                {{ section.settings.subtitle }}
              </p>
            </x-cell>
          {%- endif -%}
          {%- if section.settings.title != empty -%}
            <x-cell>
              <h2 class="section-main-heading-hero{% if section.settings.heroMetaH1hasBg == true %} hasBg{% endif %}">
                {{ section.settings.title }}
              </h2>
            </x-cell>
          {%- endif -%}
          {%- if section.settings.content != empty -%}
            <x-cell style="max-width: 760px;">
              <p
                class="section-main-text{% if section.settings.heroMetaH1hasBg == true %} hasBg{% endif %}"
              >
                {{ section.settings.content }}
              </p>
            </x-cell>
          {%- endif -%}
          {%- if section.settings.cta != empty -%}
            <x-cell>
              <a href="{{ section.settings.url }}" class="button is-customized">{{ section.settings.cta }}</a>
            </x-cell>
          {%- endif -%}
        </x-flex>
      </x-cell>
    </x-flex>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "max_blocks": 2,
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "settings": [
    {
      "type": "text",
      "id": "block_id",
      "label": "Block ID"
    },
    {
        "type": "header",
        "content": "Notice",
        "info": "This section supports images and self-hosted videos. To switch between image and video blocks, first remove the block you're currently using."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heroHeight",
      "label": "Banner height",
      "default": "var(--heroHeight-f)",
      "options": [
        { "value": "var(--heroHeight-s)", "label": "Small" },
        { "value": "var(--heroHeight-m)", "label": "Medium" },
        { "value": "var(--heroHeight-l)", "label": "Large" },
        { "value": "var(--heroHeight-f)", "label": "Full" },
        { "value": "uncropped", "label": "Full uncropped" }
      ]
    },
    {
        "type": "checkbox",
        "id": "cropVideo",
        "label": "Crop video height",
        "info": "If enabled and the video is too tall, the video will be cropped and the banner height will reflect the size you selected in the option above.",
        "default": false
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Hero heading subtitle",
      "info": "Leave blank to hide heading subtitle."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Hero heading",
      "info": "Leave blank to hide heading."
    },
    {
      "type": "textarea",
      "id": "content",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Button label",
      "default": "Shop more",
      "info": "Leave blank to hide button."
    },
    {
      "type": "url",
      "id": "url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "contentPosition",
      "label": "Content position - desktop",
      "default": "center between",
      "options": [
          { "value": "top left", "label": "Top left" },
          { "value": "top center", "label": "Top center" },
          { "value": "top right", "label": "Top right" },
          { "value": "center left", "label": "Middle Left" },
          { "value": "center", "label": "Middle Center" },
          { "value": "center right", "label": "Middle Right" },
          { "value": "bottom left", "label": "Bottom left" },
          { "value": "bottom center", "label": "Bottom center" },
          { "value": "bottom right", "label": "Bottom right" },
          { "value": "top between", "label": "Top space-between" },
          { "value": "center between", "label": "Middle space-between" },
          { "value": "bottom between", "label": "Bottom space-between" }
      ]
    },
    {
        "type": "select",
        "id": "contentDirection",
        "label": "Content direction - desktop",
        "default": "row",
        "options": [
            { "value": "row", "label": "Row" },
            { "value": "column", "label": "Column" }
        ]
    },
    {
        "type": "select",
        "id": "textAlignment",
        "label": "Text alignment - desktop",
        "default": "left",
        "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
        ]
    },
    {
        "type": "select",
        "id": "contentPositionMob",
        "label": "Content position - mobile",
        "default": "center between",
        "options": [
            { "value": "top center", "label": "Top" },
            { "value": "center", "label": "Middle" },
            { "value": "bottom center", "label": "Bottom" },
            { "value": "center between", "label": "Space between" }
        ]
    },
    {
        "type": "select",
        "id": "contentDirectionMob",
        "label": "Content direction - mobile",
        "default": "column",
        "options": [
            { "value": "row", "label": "Row" },
            { "value": "column", "label": "Column" }
        ]
    },
    {
        "type": "select",
        "id": "textAlignmentMob",
        "label": "Text alignment - mobile",
        "default": "center",
        "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
        ]
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "heroMetaH1Bg",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heroMetaH1Color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "heroMetaH1hasBg",
      "label": "Enable heading background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 1,
      "settings": [
        {
            "type": "header",
            "content": "Notice",
            "info": "To use to the video block, remove this block first."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop",
          "info": "2000 x 1110px recommended"
        },
        {
          "type": "image_picker",
          "id": "imageMobile",
          "label": "Mobile",
          "info": "970 x 1110px recommended"
        },
        {
          "type": "checkbox",
          "id": "imgClickable",
          "label": "Clickable image",
          "default": false
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "limit": 1,
      "settings": [
        {
            "type": "header",
            "content": "Notice",
            "info": "To use to the image block, remove this block first."
        },
        {
            "type": "video",
            "id": "video",
            "label": "Desktop",
            "info": "Videos with a 16:9 aspect ratio are recommended."
        },
        {
            "type": "video",
            "id": "videoMobile",
            "label": "Mobile",
            "info": "Videos with a 9:16 aspect ratio are recommended."
        },
        {
            "type": "checkbox",
            "id": "videoLoop",
            "label": "Loop",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "videoMute",
            "label": "Mute",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "videoAutoplay",
            "label": "Autoplay",
            "default": false,
            "info": "Autoplay is not recommended. It is not supported on mobile devices and disabled by default in many browsers."
        },
        {
            "type": "checkbox",
            "id": "clickToPlay",
            "label": "Enable click to play",
            "info": "Click of the video container will toggle play/pause.",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "playPause",
            "label": "Enable play/pause button",
            "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "category": "Image",
      "blocks": [
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
