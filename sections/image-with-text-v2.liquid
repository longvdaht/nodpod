{% comment %}
  Image with text v2
  Desktop: image and content side by side.
  Mobile: image can be positioned above or below the content.
{% endcomment %}

{{ 'section-image-with-text-v2.css' | asset_url | stylesheet_tag }}

<section
  id="ImageWithTextV2-{{ section.id }}"
  class="image-with-text-v2 image-with-text-v2--desktop-image-{{ section.settings.desktop_image_position }} image-with-text-v2--mobile-image-{{ section.settings.mobile_image_position }}"
  style="
    --iwt-bg: {{ section.settings.background_color }};
    --iwt-text: {{ section.settings.text_color }};
    --iwt-padding-desktop: {{ section.settings.padding_vertical }}px;
    --iwt-padding-mobile: {{ section.settings.padding_vertical | times: 0.5 }}px;
  "
>
  <div class="image-with-text-v2__inner">
    <div class="image-with-text-v2__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            class: 'image-with-text-v2__image',
            widths: '600, 800, 1000, 1200, 1600, 2000',
            sizes: '(max-width: 749px) 100vw, 50vw',
            loading: 'lazy'
        }}
      {%- endif -%}
    </div>

    <div class="image-with-text-v2__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <div class="image-with-text-v2__block image-with-text-v2__heading rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {%- when 'text' -%}
            <div class="image-with-text-v2__block image-with-text-v2__text rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {%- when 'icon_text' -%}
            <div class="image-with-text-v2__block image-with-text-v2__icon-text" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="image-with-text-v2__icon-wrapper">
                  {{
                    block.settings.icon
                    | image_url: width: 200
                    | image_tag:
                      class: 'image-with-text-v2__icon',
                      widths: '60, 100, 140, 200',
                      loading: 'lazy'
                  }}
                </div>
              {%- endif -%}

              <div class="image-with-text-v2__icon-content">
                {%- if block.settings.heading != blank -%}
                  <div class="image-with-text-v2__icon-heading">{{ block.settings.heading }}</div>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="image-with-text-v2__icon-description rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </div>

          {%- when 'benefits' -%}
            <div class="image-with-text-v2__block image-with-text-v2__benefits rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text v2",
  "tag": "section",
  "class": "section-image-with-text-v2",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top & bottom",
      "default": 50,
      "info": "Mobile uses 50% of this value."
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f4f7fa" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#555555" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Heading" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "icon_text",
      "name": "Icon with text",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "benefits",
      "name": "Benefits",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "Use | between items to match the reference layout."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text v2",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "icon_text"
        },
        {
          "type": "icon_text"
        },
        {
          "type": "icon_text"
        },
        {
          "type": "benefits"
        }
      ]
    }
  ]
}
{% endschema %}