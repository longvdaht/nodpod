<script>
  (function () {
    function initTabs(root) {
      if (!root) return;
      const list = root.querySelector('.pdp-tabs__list');
      const tabs = Array.from(list.querySelectorAll('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll('[role="tabpanel"]'));
      const indicator = root.querySelector('.pdp-tabs__indicator');
      if (!tabs.length || !indicator) return;

      function positionIndicator() {
        const active = list.querySelector('.pdp-tabs__tab.is-active') || tabs[0];
        if (!active) return;
        const left = active.offsetLeft - list.scrollLeft;
        indicator.style.width = active.offsetWidth + 'px';
        indicator.style.transform = 'translateX(' + left + 'px)';
      }

      function activate(idx) {
        tabs.forEach((t, i) => {
          t.classList.toggle('is-active', i === idx);
          t.setAttribute('aria-selected', i === idx ? 'true' : 'false');
          t.setAttribute('tabindex', i === idx ? '0' : '-1');
        });
        panels.forEach((p, i) => p.classList.toggle('is-active', i === idx));
        positionIndicator();
      }

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => activate(i));
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            activate((i + 1) % tabs.length);
          }
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            activate((i - 1 + tabs.length) % tabs.length);
          }
        });
      });

      list.addEventListener('scroll', () => requestAnimationFrame(positionIndicator));
      window.addEventListener('resize', () => requestAnimationFrame(positionIndicator));

      // initial paint
      positionIndicator();
    }

    function boot() {
      document.querySelectorAll('.pdp-tabs').forEach(initTabs);
    }
    document.addEventListener('DOMContentLoaded', boot);
    document.addEventListener('shopify:section:load', (e) => e.target.querySelectorAll('.pdp-tabs').forEach(initTabs));
  })();
</script>

<script>
  (function () {
    const ROOT = '#ProductInfo-{{ section.id }}';
    const VARIANT_WRAPPER = '#variant-selects-{{ section.id }}, #variant-radios-{{ section.id }}';
    const LIGHT_LUMINANCE_THRESHOLD = 0.52;

    // --- utils ---
    function setImp(el, prop, value) {
      el && el.style.setProperty(prop, value, 'important');
    }
    function clearImp(el, props = []) {
      if (!el) return;
      props.forEach((p) => el.style.removeProperty(p));
    }
    function parseColor(str) {
      if (!str) return null;
      const tmp = document.createElement('span');
      tmp.style.color = str;
      tmp.style.display = 'none';
      document.body.appendChild(tmp);
      const rgb = getComputedStyle(tmp).color;
      tmp.remove();
      const m = rgb && rgb.match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)/i);
      return m ? { r: +m[1], g: +m[2], b: +m[3] } : null;
    }
    function relLum({ r, g, b }) {
      const t = (v) => ((v /= 255) <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4));
      return 0.2126 * t(r) + 0.7152 * t(g) + 0.0722 * t(b);
    }
    function isLightColor(c, th = LIGHT_LUMINANCE_THRESHOLD) {
      const rgb = parseColor(c);
      return rgb ? relLum(rgb) > th : false;
    }

    // --- state ---
    let _lastStyledThumb = null;
    let _currentPrimary = '#000000';

    // --- helpers ---
    function getSelectedColorInput(info) {
      return info.querySelector('.pdp-color__input:checked');
    }
    function getActiveThumb() {
      const root = document.querySelector('.product__media-wrapper');
      if (!root) return null;
      return root.querySelector('.thumbnail[aria-current="true"]') || root.querySelector('.thumbnail[aria-current]');
    }
    function styleActiveThumbByColor(color) {
      const active = getActiveThumb();
      if (_lastStyledThumb && _lastStyledThumb !== active) {
        clearImp(_lastStyledThumb, ['color', 'border-color']);
        _lastStyledThumb = null;
      }
      if (active) {
        setImp(active, 'color', color);
        setImp(active, 'border-color', color);
        setImp(active, 'border-width', '2px');
        setImp(active, 'border-style', 'solid');
        _lastStyledThumb = active;
      }
    }

    function applyTheme() {
      const info = document.querySelector(ROOT);
      if (!info) return;

      const colorInput = getSelectedColorInput(info);
      if (!colorInput) {
        reset();
        return;
      }

      const ds = colorInput.dataset || {};
      const primary = (ds.variantColor || '').trim();
      const secondary = (ds.variantSecondaryColor || '').trim();
      const multicolor = ds.variantMulticolor === 'true';
      const isBundle = info.closest('product-info')?.dataset?.isBundle === 'true';

      if (isBundle || multicolor || secondary || !primary) {
        reset();
        return;
      }

      _currentPrimary = primary;
      const textColor = isLightColor(primary) ? '#5d5e5d' : '#ffffff';

      styleActiveThumbByColor(primary);

      const utility = document.querySelector('.utility-bar');
      if (utility) {
        setImp(utility, 'background-color', primary);
        setImp(utility, 'color', textColor);
        utility.querySelectorAll('a, button, svg, .utility-bar__text').forEach((el) => {
          setImp(el, 'color', textColor);
          if (el.tagName === 'SVG') setImp(el, 'stroke', textColor);
        });
      }

      document.querySelectorAll('.announcement-bar__message span').forEach((el) => setImp(el, 'color', textColor));

      const atc = info.querySelector('.product-form__submit');
      if (atc) {
        setImp(atc, 'background-color', primary);
        setImp(atc, 'border-color', primary);
        setImp(atc, 'color', textColor);
      }

      const tabsIndicator = document.querySelector('.pdp-tabs__indicator');
      if (tabsIndicator) {
        setImp(tabsIndicator, 'background-color', primary);
      }
    }

    function reset() {
      if (_lastStyledThumb) {
        clearImp(_lastStyledThumb, ['color', 'border-color', 'box-shadow']);
        _lastStyledThumb = null;
      }
      const utility = document.querySelector('.utility-bar');
      if (utility) {
        utility.style.removeProperty('background-color');
        utility.style.removeProperty('color');
        utility.querySelectorAll('a, button, svg, .utility-bar__text').forEach((el) => {
          el.style.removeProperty('color');
          if (el.tagName === 'SVG') el.style.removeProperty('stroke');
        });
      }
      document.querySelectorAll('.announcement-bar__message span').forEach((el) => el.style.removeProperty('color'));

      const info = document.querySelector(ROOT);
      const atc = info?.querySelector('.product-form__submit');
      if (atc) {
        atc.style.removeProperty('background-color');
        atc.style.removeProperty('border-color');
        atc.style.removeProperty('color');
      }

      const tabsIndicator = document.querySelector('.pdp-tabs__indicator');
      if (tabsIndicator) {
        tabsIndicator.style.removeProperty('background-color');
      }
    }

    // --- listeners ---
    document.addEventListener(
      'change',
      (e) => {
        if (e.target.closest(VARIANT_WRAPPER)) {
          requestAnimationFrame(applyTheme);
          setTimeout(applyTheme, 60);
        }
      },
      true
    );

    document.addEventListener(
      'click',
      (e) => {
        if (e.target.closest('.product__media-wrapper .thumbnail')) {
          requestAnimationFrame(() => styleActiveThumbByColor(_currentPrimary));
        }
      },
      true
    );

    function observe() {
      const media = document.querySelector('.product__media-wrapper');
      if (media) {
        const moThumbs = new MutationObserver(() =>
          requestAnimationFrame(() => styleActiveThumbByColor(_currentPrimary))
        );
        moThumbs.observe(media, { subtree: true, attributes: true, attributeFilter: ['aria-current'] });
      }
      const wrapper = document.querySelector(VARIANT_WRAPPER);
      if (wrapper) {
        const moVariants = new MutationObserver(() => requestAnimationFrame(applyTheme));
        moVariants.observe(wrapper, { subtree: true, childList: true, attributes: true, attributeFilter: ['checked'] });
      }
    }

    document.addEventListener('shopify:section:load', () => {
      applyTheme();
      observe();
    });
    document.addEventListener('DOMContentLoaded', () => {
      applyTheme();
      observe();
    });
  })();
</script>

